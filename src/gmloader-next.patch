+
+void ui_update(SDL_GameController *pad, int win_w, int win_h)
+{
+    read_pad(pad);
+    Uint32 now = SDL_GetTicks();
+
+    if (pad_now[SDL_CONTROLLER_BUTTON_BACK] && pad_now[SDL_CONTROLLER_BUTTON_START]) {
+        if (!quit_combo_since) quit_combo_since = now;
+        else if (now - quit_combo_since > 150) {
+            if (!quit_requested) LOG("SELECT+START: quit\n");
+            quit_requested = true;
+        }
+        return;
+    }
+    quit_combo_since = 0;
+
+    /* keyboard button: show/hide the keyboard at any time */
+    const bool kb_was_visible = vk_visible;
+    const bool text_dialog = (dlg == PD_INPUT || dlg == PD_LOGIN);
+    int vkb = map_cfg_button(cfg_vk_button);
+    if (vkb >= 0 && pressed(vkb)) {
+        if (text_dialog) {
+            set_vk_visible(!vk_visible);
+        } else if (dlg == PD_NONE) {
+            if (vk_visible) {
+                vk_manual = false;
+                set_vk_visible(false);
+            } else {
+                vk_manual = true;
+                if (!vk_from_game) {
+                    extern const char *port_keyboard_string();
+                    const char *ks = port_keyboard_string();
+                    vk_text = ks ? ks : "";
+                }
+                vk_caret = vk_text.size();
+                set_vk_visible(true);
+            }
+        }
+    } else if (kb_was_visible) {
+        handle_keyboard_pad();
+    } else if (text_dialog) {
+        /* keyboard hidden inside a text dialog */
+        if (pressed(SDL_CONTROLLER_BUTTON_START) || pressed(SDL_CONTROLLER_BUTTON_A)) dialog_confirm(true);
+        else if (pressed(SDL_CONTROLLER_BUTTON_BACK) || pressed(SDL_CONTROLLER_BUTTON_B)) dialog_confirm(false);
+    } else if (dlg != PD_NONE) {
+        handle_dialog_pad();
+    }
+
+    /* pointer */
+    if (pad && cfg_ptr_stick >= 0) {
+        float ax = SDL_GameControllerGetAxis(pad, cfg_ptr_stick ? SDL_CONTROLLER_AXIS_RIGHTX : SDL_CONTROLLER_AXIS_LEFTX) / 32767.0f;
+        float ay = SDL_GameControllerGetAxis(pad, cfg_ptr_stick ? SDL_CONTROLLER_AXIS_RIGHTY : SDL_CONTROLLER_AXIS_LEFTY) / 32767.0f;
+        float mag = sqrtf(ax * ax + ay * ay);
+        float dt = g_last_ticks ? (now - g_last_ticks) / 1000.0f : 0.016f;
+        if (dt > 0.1f) dt = 0.1f;
+        if (ptr_x < 0) { ptr_x = win_w * 0.5f; ptr_y = win_h * 0.5f; }
+
+        /* press the toggle button (L2): pointer off / on.
+           Not while START is held too (SELECT+START = quit). */
+        int c1t = map_cfg_button(cfg_ptr_toggle);
+        bool held = c1t >= 0 && pad_now[c1t] && !pad_now[SDL_CONTROLLER_BUTTON_START] &&
+                    !vk_visible && dlg == PD_NONE;   /* L2 moves the text cursor there */
+        if (held && !ptr_toggle_was_held) ptr_click_down_at = now;
+        ptr_toggle_was_held = held;
+        if (held && !ptr_toggle_latched && now - ptr_click_down_at >= 0) {
+            ptr_enabled = !ptr_enabled;
+            ptr_toggle_latched = true;
+            ptr_visible = ptr_enabled;
+            ptr_last_move = now;
+            toast = ptr_enabled ? "Pointer ON" : "Pointer OFF (L2 to turn it on)";
+            toast_until = now + 2000;
+            LOG("pointer %s\n", ptr_enabled ? "on" : "off");
+        }
+        if (!held) ptr_toggle_latched = false;
+        if (!ptr_enabled) {
+            ptr_btn = false;
+            if (!ptr_enabled) ptr_visible = false;
+            g_last_ticks = now;
+            return;
+        }
+
+        if (mag > 0.18f) {
+            float k = (mag - 0.18f) / 0.82f;
+            float speed = (0.08f + 0.6f * k * k) * win_h * cfg_ptr_speed; /* px/s */
+            ptr_x += ax / mag * speed * dt;
+            ptr_y += ay / mag * speed * dt;
+            ptr_x = std::max(0.0f, std::min((float)win_w - 1, ptr_x));
+            ptr_y = std::max(0.0f, std::min((float)win_h - 1, ptr_y));
+            ptr_visible = true;
+            ptr_last_move = now;
+        }
+        int c1 = map_cfg_button(cfg_ptr_click), c2 = map_cfg_button(cfg_ptr_click2);
+        bool down = (c1 >= 0 && pad_now[c1]) || (c2 >= 0 && pad_now[c2]);
+        if (down) { ptr_visible = true; ptr_last_move = now; }
+        ptr_btn = down;
+        if (ptr_visible && now - ptr_last_move > 5000 && !down)
+            ptr_visible = false;
+    }
+    g_last_ticks = now;
+}
