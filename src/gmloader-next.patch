+/*
+ * Minimal java.lang.Object / java.lang.Double, needed by the runner to pass
+ * real values to and from Java extension functions (CallExtensionFunction).
+ */
+#include <new>
+#include <stdlib.h>
+#include <string.h>
+
+#include "jni.h"
+#include "jni_internals.h"
+#include "lang.h"
+
+/* java.lang.Object ------------------------------------------------------- */
+const ManagedMethod JObjectMethods[] = {
+    {NULL}
+};
+
+Class JObject::clazz = {
+    .classpath = "java/lang/Object",
+    .classname = "Object",
+    .managed_methods = JObjectMethods,
+    .native_methods = NULL,
+    .fields = NULL,
+    .instance_size = sizeof(void *)
+};
+
+/* java.lang.Double ------------------------------------------------------- */
+JDouble::JDouble(double v) : value(v) {}
+
+void JDouble::init(JNIEnv *env, jobject obj, jclass clz, jdouble v)
+{
+    new (obj) JDouble(v);
+}
+
+jdouble JDouble::doubleValue(JNIEnv *env, jobject obj)
+{
+    return obj ? ((JDouble *)obj)->value : 0.0;
+}
+
+const ManagedMethod JDoubleMethods[] = {
+    REGISTER_INIT_METHOD(JDouble, JDouble::init, "(D)V"),
+    ManagedMethod::Register<&JDouble::doubleValue>(JDouble::clazz, "doubleValue", "()D"),
+    {NULL}
+};
+
+const FieldId JDoubleFields[] = {
+    {NULL},
+};
+
+Class JDouble::clazz = {
+    .classpath = "java/lang/Double",
+    .classname = "Double",
+    .managed_methods = JDoubleMethods,
+    .native_methods = NULL,
+    .fields = JDoubleFields,
+    .instance_size = sizeof(JDouble)
+};
+
+JDouble *JDouble::make(double v)
+{
+    void *mem = calloc(1, sizeof(JDouble));
+    return new (mem) JDouble(v);
+}
+
+static const int registered_obj = ClassRegistry::register_class(JObject::clazz);
+static const int registered_dbl = ClassRegistry::register_class(JDouble::clazz);
