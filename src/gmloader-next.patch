+/* The runner's built-in function table: the_functions -> {name, fn, argc}.
+   YYC code calls built-ins by index, and the Android runner registers its own
+   gamepad functions (fed by Android input events that never arrive here):
+   point every gamepad_* entry to the loader's SDL implementation. */
+struct RunnerFunc { const char *name; routine_t fn; int argc; int pad; };
+
+/* PORT_DEBUG_PAD=1: log the gamepad buttons the game asks for (once each) */
+static bool dbg_seen[3][32];
+template <int N>
+ABI_ATTR static void dbg_gp(RValue *ret, void *self, void *other, int argc, RValue *args)
+{
+    static const routine_t real[3] = {gamepad_button_check, gamepad_button_check_pressed, gamepad_button_check_released};
+    if (argc >= 2) {
+        int b = YYGetInt32(args, 1);
+        if (b >= 32769) b -= 32769;
+        if (b >= 0 && b < 32 && !dbg_seen[N][b]) {
+            dbg_seen[N][b] = true;
+            LOG("game reads pad %d button %d (%s)\n", YYGetInt32(args, 0), b, N == 0 ? "held" : (N == 1 ? "pressed" : "released"));
+        }
+    }
+    real[N](ret, self, other, argc, args);
+}
+/* PORT_TRACE="name1,name2,...": log calls of runner functions (debug) */
+#define TRACE_MAX 16
+static routine_t trace_orig[TRACE_MAX];
+static const char *trace_name[TRACE_MAX];
+static int trace_count[TRACE_MAX];
+template <int N>
+ABI_ATTR static void trace_fn(RValue *ret, void *self, void *other, int argc, RValue *args)
+{
+    trace_orig[N](ret, self, other, argc, args);
+    /* log each distinct first argument once (max 40 per function) */
+    static double seen[TRACE_MAX][40];
+    double a0 = -12345;
+    if (argc > 0 && (args[0].kind & 0xffffff) == VALUE_REAL) a0 = args[0].rvalue.val;
+    else if (argc > 0 && (args[0].kind & 0xffffff) == 7) a0 = (double)args[0].rvalue.v32;   /* int32 */
+    else if (argc > 0 && (args[0].kind & 0xffffff) == 10) a0 = (double)args[0].rvalue.v64;  /* int64 */
+    else if (argc > 0 && (args[0].kind & 0xffffff) == 15) a0 = (double)(args[0].rvalue.v64 & 0xffffffff) + 1e9 * (double)(args[0].rvalue.v64 >> 32); /* ref */
+    double r = ((ret->kind & 0xffffff) == VALUE_REAL) ? ret->rvalue.val :
+               (((ret->kind & 0xffffff) == 13) ? (double)(ret->rvalue.val != 0) : -999);
+    double key = a0 + (r == -999 ? 0 : r) * 1e-3;   /* same args + same result: log once */
+    if (!strcmp(trace_name[N], "audio_play_sound")) key = trace_count[N] + 0.5; /* every call */
+    for (int i = 0; i < trace_count[N]; i++) if (seen[N][i] == key) return;
+    if (trace_count[N] >= 40) return;
+    seen[N][trace_count[N]++] = key;
+    char extra[160] = "";
+    for (int i = 1; i < argc && i < 6; i++) {
+        char b[32];
+        int k = args[i].kind & 0xffffff;
+        if (k == VALUE_REAL) snprintf(b, sizeof(b), " a%d=%g", i, args[i].rvalue.val);
+        else snprintf(b, sizeof(b), " a%d=<%d:%llx>", i, k, (unsigned long long)args[i].rvalue.v64);
+        strncat(extra, b, sizeof(extra) - strlen(extra) - 1);
+    }
+    LOG("trace %s(argc %d, a0 %g [%llx] kind %d%s) -> %g\n", trace_name[N], argc, a0,
+        argc > 0 ? (unsigned long long)args[0].rvalue.v64 : 0ULL, argc > 0 ? (args[0].kind & 0xffffff) : -1, extra, r);
+}
+template <int N> struct TraceTab { static void fill(routine_t *t) { t[N] = trace_fn<N>; TraceTab<N - 1>::fill(t); } };
+template <> struct TraceTab<-1> { static void fill(routine_t *t) {} };
+
+static void install_traces()
+{
+    const char *env = getenv("PORT_TRACE");
+    if (!env) return;
+    static routine_t wrappers[TRACE_MAX];
+    TraceTab<TRACE_MAX - 1>::fill(wrappers);
+    RunnerFunc **tab = (RunnerFunc **)so_symbol(g_yoyo, "the_functions");
+    int *numb = (int *)so_symbol(g_yoyo, "the_numb");
+    if (!tab || !*tab || !numb) return;
+    std::string list = std::string(",") + env + ",";
+    int n = 0;
+    for (int i = 0; i < *numb && n < TRACE_MAX; i++) {
+        RunnerFunc *e = &(*tab)[i];
+        if (!e->name || !e->fn) continue;
+        if (list.find(std::string(",") + e->name + ",") == std::string::npos) continue;
+        trace_orig[n] = e->fn;
+        trace_name[n] = e->name;
+        e->fn = wrappers[n];
+        n++;
+    }
+    LOG("tracing %d functions\n", n);
+}
+
+static void fix_function_table()
+{
+    struct { const char *name; routine_t fn; } fix[] = {
+        {"gamepad_is_supported", gamepad_is_supported},
+        {"gamepad_get_device_count", gamepad_get_device_count},
+        {"gamepad_is_connected", gamepad_is_connected},
+        {"gamepad_get_description", gamepad_get_description},
+        {"gamepad_get_button_threshold", gamepad_get_button_threshold},
+        {"gamepad_set_button_threshold", gamepad_set_button_threshold},
+        {"gamepad_axis_count", gamepad_axis_count},
+        {"gamepad_axis_value", gamepad_axis_value},
+        {"gamepad_button_check", gamepad_button_check},
+        {"gamepad_button_check_pressed", gamepad_button_check_pressed},
+        {"gamepad_button_check_released", gamepad_button_check_released},
+        {"gamepad_button_count", gamepad_button_count},
+        {"gamepad_button_value", gamepad_button_value},
+        {"gamepad_set_vibration", gamepad_set_vibration},
+        {"gamepad_set_axis_deadzone", gamepad_set_axis_deadzone},
+        {"gamepad_get_axis_deadzone", gamepad_get_axis_deadzone},
+        {"gamepad_set_colour", gamepad_set_colour},
+        {"gamepad_set_color", gamepad_set_colour},
+    };
+    if (getenv("PORT_DEBUG_PAD")) {
+        for (auto &f : fix) {
+            if (!strcmp(f.name, "gamepad_button_check")) f.fn = dbg_gp<0>;
+            if (!strcmp(f.name, "gamepad_button_check_pressed")) f.fn = dbg_gp<1>;
+            if (!strcmp(f.name, "gamepad_button_check_released")) f.fn = dbg_gp<2>;
+        }
+    }
+    RunnerFunc **tab = (RunnerFunc **)so_symbol(g_yoyo, "the_functions");
+    int *numb = (int *)so_symbol(g_yoyo, "the_numb");
+    if (!tab || !*tab || !numb) { LOG("function table not found\n"); return; }
+    int patched = 0;
+    for (int i = 0; i < *numb; i++) {
+        RunnerFunc *e = &(*tab)[i];
+        if (!e->name || strncmp(e->name, "gamepad_", 8) != 0) continue;
+        for (auto &f : fix) {
+            if (strcmp(e->name, f.name) == 0 && e->fn != f.fn) {
+                e->fn = f.fn;
+                patched++;
+            }
+        }
+    }
+    if (patched) LOG("gamepad: %d runner functions -> SDL gamepad\n", patched);
+}
