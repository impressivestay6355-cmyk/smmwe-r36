+void ui_init(SDL_Window *win)
+{
+    g_win = win;
+    const char *ka = getenv("PORT_KEEP_ASPECT");
+    ar_on = (ka && atoi(ka)) ? 1 : 0;
+    const char *ar = getenv("PORT_ASPECT");   /* e.g. "16:9" */
+    if (ar && sscanf(ar, "%d:%d", &ar_num, &ar_den) != 2) { ar_num = 16; ar_den = 9; }
+    if (ar_num <= 0 || ar_den <= 0) { ar_num = 16; ar_den = 9; }
+    if (ar_on) ar_install_hooks();
+    cfg_vk_button = parse_button(getenv("PORT_KEYBOARD_BUTTON"), cfg_vk_button);
+    cfg_ptr_click = parse_button(getenv("PORT_POINTER_CLICK"), cfg_ptr_click);
+    cfg_ptr_toggle = parse_button(getenv("PORT_POINTER_TOGGLE"), cfg_ptr_toggle);
+    cfg_ptr_click2 = parse_button(getenv("PORT_POINTER_CLICK2"), cfg_ptr_click2);
+    const char *ps = getenv("PORT_POINTER_STICK");
+    if (ps) cfg_ptr_stick = !strcasecmp(ps, "left") ? 0 : (!strcasecmp(ps, "none") ? -1 : 1);
+    if (getenv("PORT_POINTER_SPEED")) cfg_ptr_speed = (float)atof(getenv("PORT_POINTER_SPEED"));
+    if (cfg_ptr_speed <= 0.05f) cfg_ptr_speed = 1.0f;
+    if (getenv("PORT_HINT")) cfg_hint = atoi(getenv("PORT_HINT")) != 0;
+    if (getenv("PORT_SHOW_FPS")) cfg_show_fps = atoi(getenv("PORT_SHOW_FPS")) != 0;
+    if (getenv("PORT_VK_HOLD_MS")) cfg_hold_ms = (Uint32)atoi(getenv("PORT_VK_HOLD_MS"));
+    if (cfg_hint) hint_until = SDL_GetTicks() + 7000;
+    SDL_StopTextInput();
+}
+
+static void draw_text_field(const char *label, const std::string &text, bool focused, bool masked, float width)
+{
+    ImDrawList *dl = ImGui::GetWindowDrawList();
+    if (label && *label) ImGui::TextUnformatted(label);
+    ImVec2 p = ImGui::GetCursorScreenPos();
+    float h = g_font_px + 10.0f;
+    ImU32 bg = focused ? IM_COL32(18, 20, 24, 255) : IM_COL32(30, 32, 38, 255);
+    ImU32 bd = focused ? IM_COL32(26, 158, 224, 255) : IM_COL32(80, 84, 92, 255);
+    dl->AddRectFilled(p, ImVec2(p.x + width, p.y + h), bg, 3.0f);
+    dl->AddRect(p, ImVec2(p.x + width, p.y + h), bd, 3.0f, 0, focused ? 2.0f : 1.0f);
+
+    std::string shown;
+    size_t caret_bytes = std::min(vk_caret, text.size());
+    std::string before;
+    if (masked) {
+        size_t n = 0, nb = 0;
+        for (size_t i = 0; i < text.size(); i = utf8_next(text, i)) { n++; if (i < caret_bytes) nb++; }
+        shown.assign(n, '*');
+        before.assign(nb, '*');
+    } else {
+        shown = text;
+        before = text.substr(0, caret_bytes);
+    }
+    ImFont *f = ImGui::GetFont();
+    float bw = f->CalcTextSizeA(g_font_px, FLT_MAX, 0, before.c_str()).x;
+    float scroll = 0;
+    if (bw > width - 16) scroll = bw - (width - 16);
+    dl->PushClipRect(ImVec2(p.x + 4, p.y), ImVec2(p.x + width - 4, p.y + h), true);
+    dl->AddText(f, g_font_px, ImVec2(p.x + 6 - scroll, p.y + 5), IM_COL32(240, 240, 240, 255), shown.c_str());
+    if (focused && (SDL_GetTicks() / 500) % 2 == 0) {
+        float cx = p.x + 6 - scroll + bw;
+        dl->AddLine(ImVec2(cx, p.y + 4), ImVec2(cx, p.y + h - 4), IM_COL32(26, 158, 224, 255), 2.0f);
+    }
+    dl->PopClipRect();
+    ImGui::Dummy(ImVec2(width, h));
+}
