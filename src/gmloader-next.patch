+/* ------------------------------------------------------------------------ */
+/* Dialogs                                                                  */
+/* ------------------------------------------------------------------------ */
+/* files offered by the import picker: the import folder and its
+   subfolders (Mods/...), two levels deep; music and notes are skipped */
+static void scan_dir(const std::string &rel, int depth)
+{
+    std::string dir = rel.empty() ? dlg_dir : dlg_dir + "/" + rel;
+    DIR *d = opendir(dir.c_str());
+    if (!d) return;
+    struct dirent *e;
+    while ((e = readdir(d))) {
+        if (e->d_name[0] == '.') continue;
+        std::string n = e->d_name;
+        std::string r = rel.empty() ? n : rel + "/" + n;
+        struct stat st;
+        if (stat((dir + "/" + n).c_str(), &st) != 0) continue;
+        if (S_ISDIR(st.st_mode)) {
+            if (depth < 2) scan_dir(r, depth + 1);
+            continue;
+        }
+        if (!S_ISREG(st.st_mode)) continue;
+        const char *dot = strrchr(n.c_str(), '.');
+        if (dot && (!strcasecmp(dot, ".txt") || !strcasecmp(dot, ".ogg") || !strcasecmp(dot, ".md")))
+            continue;
+        if (!dlg_filter.empty()) {
+            if (n.size() < dlg_filter.size()) continue;
+            std::string ext = n.substr(n.size() - dlg_filter.size());
+            if (strcasecmp(ext.c_str(), dlg_filter.c_str()) != 0) continue;
+        }
+        dlg_files.push_back(r);
+    }
+    closedir(d);
+}
+
+static void scan_files()
+{
+    dlg_files.clear();
+    scan_dir("", 0);
+    std::sort(dlg_files.begin(), dlg_files.end());
+    dlg_sel = 0;
+}
+
+static void start_dialog(const PendingDialog &p)
+{
+    dlg = p.k;
+    dlg_id = p.id;
+    dlg_caption = p.cap;
+    dlg_field[0] = p.t1;
+    dlg_field[1] = p.t2;
+    dlg_default = p.t1;
+    dlg_focus = 0;
+    dlg_choice = 0;
+    LOG("dialog %d (id %d): %s\n", (int)dlg, dlg_id, dlg_caption.c_str());
+    if (dlg == PD_FILEPICK) {
+        dlg_dir = p.t1;
+        dlg_filter = p.filter;
+        scan_files();
+    }
+    if (dlg == PD_INPUT || dlg == PD_LOGIN) {
+        vk_caret = dlg_field[0].size();
+        vk_layer = 0;
+        vk_shift = false;
+        vk_visible = false;
+        set_vk_visible(true);
+    }
+}
+
+void ui_open_dialog(port_dialog_kind kind, int id, const char *caption, const char *t1, const char *t2, const char *filter)
+{
+    PendingDialog p = {kind, id, caption ? caption : "", t1 ? t1 : "", t2 ? t2 : "", filter ? filter : ""};
+    if (dlg == PD_NONE)
+        start_dialog(p);
+    else
+        dlg_queue.push_back(p);
+}
+
+static void close_dialog()
+{
+    bool had_kb = (dlg == PD_INPUT || dlg == PD_LOGIN);
+    dlg = PD_NONE;
+    if (had_kb) {
+        vk_visible = false;
+        vk_popup = false;
+        SDL_StopTextInput();
+        if (vk_from_game || vk_manual) set_vk_visible(true);
+    }
+    if (!dlg_queue.empty()) {
+        PendingDialog p = dlg_queue.front();
+        dlg_queue.erase(dlg_queue.begin());
+        start_dialog(p);
+    }
+}
+
+static void dialog_confirm(bool ok)
+{
+    switch (dlg) {
+    case PD_INPUT:
+        port_input_result(ok ? dlg_field[0].c_str() : "", ok ? 1 : 0, dlg_id);
+        break;
+    case PD_LOGIN:
+        if (ok) port_login_result(dlg_field[0].c_str(), dlg_field[1].c_str(), dlg_id);
+        else port_login_result("", "", dlg_id);
+        break;
+    case PD_MESSAGE:
+        port_input_result("OK", 1, dlg_id);
+        break;
+    case PD_QUESTION:
+        port_input_result(ok ? "1" : "0", ok ? 1 : 0, dlg_id);
+        break;
+    case PD_FILEPICK:
+        if (ok && dlg_sel >= 0 && dlg_sel < (int)dlg_files.size())
+            port_filepicker_result(dlg_dir + "/" + dlg_files[dlg_sel]);
+        else
+            port_filepicker_result("");
+        break;
+    default:
+        break;
+    }
+    close_dialog();
+}
+
+/* Enter key on the keyboard */
+static void vk_enter()
+{
+    if (dlg == PD_INPUT) { dialog_confirm(true); return; }
+    if (dlg == PD_LOGIN) {
+        if (dlg_focus == 0) { dlg_focus = 1; vk_caret = dlg_field[1].size(); }
+        else dialog_confirm(true);
+        return;
+    }
+    port_key_event(1, 66, 13);
+    if (vk_from_game || vk_manual) {
+        vk_from_game = false;
+        vk_manual = false;
+        set_vk_visible(false);
+    }
+}
+
+static void vk_press(const Key &k)
+{
+    switch (k.act) {
+    case K_TEXT: vk_insert(key_label(k)); break;
+    case K_SPACE: vk_insert(" "); break;
+    case K_BKSP: vk_backspace(); break;
+    case K_ENTER: vk_enter(); break;
+    case K_SHIFT:
+        if (vk_layer == 0) {
+            if (vk_caps) { vk_caps = false; vk_shift = false; }
+            else if (vk_shift) vk_caps = true;
+            else vk_shift = true;
+        } else {
+            vk_layer = (vk_layer == 1) ? 2 : 1;
+        }
+        break;
+    case K_LAYER:
+        vk_layer = (vk_layer == 0) ? 1 : 0;
+        vk_shift = false; vk_caps = false;
+        break;
+    case K_LEFT: { std::string *t = edit_target(); vk_caret = utf8_prev(*t, std::min(vk_caret, t->size())); break; }
+    case K_RIGHT: { std::string *t = edit_target(); vk_caret = utf8_next(*t, vk_caret); break; }
+    case K_HIDE:
+        if (dlg == PD_NONE) { vk_manual = false; vk_from_game = false; }
+        set_vk_visible(false);
+        break;
+    }
+    const auto &r = rows();
+    vk_cur_row = std::min(vk_cur_row, (int)r.size() - 1);
+    vk_cur_col = std::min(vk_cur_col, (int)r[vk_cur_row].size() - 1);
+}
+
+static void vk_move(int dx, int dy)
+{
+    const auto &r = rows();
+    if (dy) {
+        /* keep the horizontal position when changing row */
+        float units = 0, target = 0;
+        for (int c = 0; c < vk_cur_col; c++) units += r[vk_cur_row][c].w;
+        target = units + r[vk_cur_row][vk_cur_col].w * 0.5f;
+        vk_cur_row = (vk_cur_row + dy + (int)r.size()) % (int)r.size();
+        float acc = 0; int best = 0;
+        for (int c = 0; c < (int)r[vk_cur_row].size(); c++) {
+            if (target >= acc && target < acc + r[vk_cur_row][c].w) { best = c; break; }
+            acc += r[vk_cur_row][c].w;
+            best = c;
+        }
+        vk_cur_col = best;
+    }
+    if (dx) {
+        int n = (int)r[vk_cur_row].size();
+        vk_cur_col = (vk_cur_col + dx + n) % n;
+    }
+}
+
+/* ------------------------------------------------------------------------ */
+/* Pad handling                                                             */
+/* ------------------------------------------------------------------------ */
+static bool pressed(int b) { return b >= 0 && b < NBTN && pad_now[b] && !pad_prev[b]; }
+static bool released(int b) { return b >= 0 && b < NBTN && !pad_now[b] && pad_prev[b]; }
+
+/* pressed, with auto-repeat while held */
+static bool pressed_rep(int b)
+{
+    if (b < 0 || b >= NBTN) return false;
+    Uint32 now = SDL_GetTicks();
+    if (pressed(b)) { pad_down_at[b] = now; pad_repeat_at[b] = now + 320; return true; }
+    if (pad_now[b] && now >= pad_repeat_at[b]) { pad_repeat_at[b] = now + 85; return true; }
+    return false;
+}
+
+enum { VB_UP = 20, VB_DOWN, VB_LEFT, VB_RIGHT };
+
+static void read_pad(SDL_GameController *pad)
+{
+    memcpy(pad_prev, pad_now, sizeof(pad_now));
+    memset(pad_now, 0, sizeof(pad_now));
+    if (!pad) return;
+    for (int b = 0; b < SDL_CONTROLLER_BUTTON_MAX && b < 20; b++)
+        pad_now[b] = SDL_GameControllerGetButton(pad, (SDL_GameControllerButton)b) != 0;
+    /* triggers as buttons (indexes 24/25) */
+    pad_now[24] = SDL_GameControllerGetAxis(pad, SDL_CONTROLLER_AXIS_TRIGGERLEFT) > 12000;
+    pad_now[25] = SDL_GameControllerGetAxis(pad, SDL_CONTROLLER_AXIS_TRIGGERRIGHT) > 12000;
+    /* left stick as d-pad for the overlay */
+    int lx = SDL_GameControllerGetAxis(pad, SDL_CONTROLLER_AXIS_LEFTX);
+    int ly = SDL_GameControllerGetAxis(pad, SDL_CONTROLLER_AXIS_LEFTY);
+    pad_now[VB_UP] = pad_now[SDL_CONTROLLER_BUTTON_DPAD_UP] || ly < -16000;
+    pad_now[VB_DOWN] = pad_now[SDL_CONTROLLER_BUTTON_DPAD_DOWN] || ly > 16000;
+    pad_now[VB_LEFT] = pad_now[SDL_CONTROLLER_BUTTON_DPAD_LEFT] || lx < -16000;
+    pad_now[VB_RIGHT] = pad_now[SDL_CONTROLLER_BUTTON_DPAD_RIGHT] || lx > 16000;
+}
+
+static int map_cfg_button(int b)
+{
+    if (b == 100) return 24;
+    if (b == 101) return 25;
+    return b;
+}
+
+static void handle_keyboard_pad()
+{
+    const auto &r = rows();
+    if (vk_popup) {
+        int n = (int)vk_variants.size();
+        if (pressed_rep(VB_LEFT) || pressed_rep(VB_UP)) vk_variant_idx = (vk_variant_idx - 1 + n) % n;
+        if (pressed_rep(VB_RIGHT) || pressed_rep(VB_DOWN)) vk_variant_idx = (vk_variant_idx + 1) % n;
+        if (pressed(SDL_CONTROLLER_BUTTON_A)) {
+            vk_insert(vk_variants[vk_variant_idx]);
+            vk_popup = false;
+        }
+        if (pressed(SDL_CONTROLLER_BUTTON_B)) vk_popup = false;
+        return;
+    }
+
+    if (pressed_rep(VB_UP)) { vk_move(0, -1); vk_a_held = false; }
+    if (pressed_rep(VB_DOWN)) { vk_move(0, 1); vk_a_held = false; }
+    if (pressed_rep(VB_LEFT)) { vk_move(-1, 0); vk_a_held = false; }
+    if (pressed_rep(VB_RIGHT)) { vk_move(1, 0); vk_a_held = false; }
+
+    const Key &k = r[vk_cur_row][vk_cur_col];
+    if (pressed(SDL_CONTROLLER_BUTTON_A)) {
+        const char *lbl = key_label(k);
+        bool has_var = k.act == K_TEXT && strlen(lbl) == 1 && isalpha((unsigned char)lbl[0]);
+        if (has_var) {
+            vk_a_held = true;
+            vk_a_down_at = SDL_GetTicks();
+        } else if (k.act == K_BKSP || k.act == K_LEFT || k.act == K_RIGHT) {
+            vk_press(k);
+            pad_repeat_at[SDL_CONTROLLER_BUTTON_A] = SDL_GetTicks() + 400;
+        } else {
+            vk_press(k);
+        }
+    } else if (pad_now[SDL_CONTROLLER_BUTTON_A] && !vk_a_held &&
+               (k.act == K_BKSP || k.act == K_LEFT || k.act == K_RIGHT) &&
+               SDL_GetTicks() >= pad_repeat_at[SDL_CONTROLLER_BUTTON_A]) {
+        vk_press(k);
+        pad_repeat_at[SDL_CONTROLLER_BUTTON_A] = SDL_GetTicks() + 80;
+    }
+    if (vk_a_held) {
+        if (released(SDL_CONTROLLER_BUTTON_A)) {
+            vk_a_held = false;
+            vk_press(k);
+        } else if (SDL_GetTicks() - vk_a_down_at > cfg_hold_ms) {
+            const char *lbl = key_label(k);
+            int idx = tolower((unsigned char)lbl[0]) - 'a';
+            vk_variants = split_ws(isupper((unsigned char)lbl[0]) ? variants_upper[idx] : variants_lower[idx]);
+            vk_a_held = false;
+            if (vk_variants.size() > 1) {
+                vk_popup = true;
+                vk_variant_idx = 0;
+            } else {
+                vk_press(k);
+            }
+        }
+    }
+
+    if (pressed_rep(SDL_CONTROLLER_BUTTON_B)) vk_backspace();
+    if (pressed_rep(SDL_CONTROLLER_BUTTON_X)) vk_insert(" ");
+    if (pressed(SDL_CONTROLLER_BUTTON_Y)) {
+        if (vk_layer == 0) vk_shift = !vk_shift, vk_caps = false;
+        else vk_layer = (vk_layer == 1) ? 2 : 1;
+    }
+    if (pressed(SDL_CONTROLLER_BUTTON_LEFTSHOULDER)) { vk_layer = (vk_layer + 2) % 3; vk_shift = false; vk_caps = false; }
+    if (pressed(SDL_CONTROLLER_BUTTON_RIGHTSHOULDER)) { vk_layer = (vk_layer + 1) % 3; vk_shift = false; vk_caps = false; }
+    if (pressed_rep(24)) { std::string *t = edit_target(); vk_caret = utf8_prev(*t, std::min(vk_caret, t->size())); }
+    if (pressed_rep(25)) { std::string *t = edit_target(); vk_caret = utf8_next(*t, vk_caret); }
+    if (pressed(SDL_CONTROLLER_BUTTON_START)) vk_enter();
+    if (pressed(SDL_CONTROLLER_BUTTON_BACK)) {
+        if (dlg == PD_INPUT || dlg == PD_LOGIN) dialog_confirm(false);
+        else { vk_manual = false; vk_from_game = false; set_vk_visible(false); }
+    }
+    const auto &r2 = rows();
+    vk_cur_row = std::min(vk_cur_row, (int)r2.size() - 1);
+    vk_cur_col = std::min(vk_cur_col, (int)r2[vk_cur_row].size() - 1);
+}
+
+static void handle_dialog_pad()
+{
+    switch (dlg) {
+    case PD_MESSAGE:
+    case PD_INFO:
+        if (pressed(SDL_CONTROLLER_BUTTON_A) || pressed(SDL_CONTROLLER_BUTTON_B) || pressed(SDL_CONTROLLER_BUTTON_START))
+            dialog_confirm(true);
+        break;
+    case PD_QUESTION:
+        if (pressed_rep(VB_LEFT) || pressed_rep(VB_RIGHT)) dlg_choice ^= 1;
+        if (pressed(SDL_CONTROLLER_BUTTON_A) || pressed(SDL_CONTROLLER_BUTTON_START)) dialog_confirm(dlg_choice == 0);
+        if (pressed(SDL_CONTROLLER_BUTTON_B)) dialog_confirm(false);
+        break;
+    case PD_FILEPICK: {
+        int n = (int)dlg_files.size();
+        if (n > 0 && pressed_rep(VB_UP)) dlg_sel = (dlg_sel - 1 + n) % n;
+        if (n > 0 && pressed_rep(VB_DOWN)) dlg_sel = (dlg_sel + 1) % n;
+        if (n > 0 && pressed_rep(VB_LEFT)) dlg_sel = std::max(0, dlg_sel - 8);
+        if (n > 0 && pressed_rep(VB_RIGHT)) dlg_sel = std::min(n - 1, dlg_sel + 8);
+        if (pressed(SDL_CONTROLLER_BUTTON_A) || pressed(SDL_CONTROLLER_BUTTON_START)) dialog_confirm(n > 0);
+        if (pressed(SDL_CONTROLLER_BUTTON_B) || pressed(SDL_CONTROLLER_BUTTON_BACK)) dialog_confirm(false);
+        if (pressed(SDL_CONTROLLER_BUTTON_Y)) scan_files();
+        break;
+    }
+    default:
+        break;
+    }
+}
