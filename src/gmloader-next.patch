diff --git a/gmloader/port.h b/gmloader/port.h
new file mode 100644
index 0000000..3670373
--- /dev/null
+++ b/gmloader/port.h
@@ -0,0 +1,60 @@
+#pragma once
+/*
+ * Handheld port layer: Java extension emulation, HTTP, dialogs, on-screen
+ * keyboard, gamepad pointer and display options.
+ */
+#include <SDL2/SDL.h>
+#include <string>
+#include "jni.h"
+#include "so_util.h"
+
+/* -- port_ext.cpp -------------------------------------------------------- */
+void port_init(JNIEnv *env, so_module *yoyo);      /* after modules are loaded  */
+void port_after_startup();                          /* after RunnerJNILib::Startup */
+void port_frame_begin();                            /* main thread, before Process */
+const std::string &port_storage_root();             /* "internal storage" root */
+const std::string &port_files_dir();                /* getExternalFilesDir()    */
+bool port_network_up();
+
+/* Async results delivered to the runner (main thread only). */
+void port_input_result(const char *text, int ok, int id);
+void port_login_result(const char *user, const char *pass, int id);
+void port_vk_status(bool visible, int height);
+void port_vk_text(const std::string &utf8);
+void port_key_event(int down, int keycode, int ch);
+void port_filepicker_result(const std::string &path);
+
+/* -- port_ui.cpp ---------------------------------------------------------- */
+enum port_dialog_kind {
+    PD_NONE = 0,
+    PD_INPUT,       /* get_string_async            */
+    PD_LOGIN,       /* get_login_async             */
+    PD_MESSAGE,     /* show_message_async          */
+    PD_QUESTION,    /* show_question_async         */
+    PD_FILEPICK,    /* FilePicker extension        */
+    PD_INFO,        /* port message (e.g. URL)     */
+};
+
+void ui_init(SDL_Window *win);
+void ui_open_dialog(port_dialog_kind kind, int id, const char *caption,
+                    const char *text1, const char *text2, const char *filter);
+void ui_vk_toggle(bool show, const std::string &initial, bool from_game);
+bool ui_vk_visible();
+int  ui_vk_height();
+void ui_vk_set_text(const std::string &utf8);
+
+/* Input routing. Returns true when the overlay consumes the pad this frame. */
+bool ui_capture_pad();
+void ui_update(SDL_GameController *pad, int win_w, int win_h);
+bool ui_handle_event(const SDL_Event *ev);
+void ui_draw(int win_w, int win_h);
+
+/* Gamepad pointer (right stick). */
+bool ui_pointer_active();
+void ui_pointer_state(int *x, int *y, Uint32 *buttons);
+
+/* Keep aspect ratio (PORT_KEEP_ASPECT=1). */
+void port_game_size(int win_w, int win_h, int *gw, int *gh);
+void port_map_mouse(int *x, int *y);
+bool ui_quit_requested();
+float port_fps();
diff --git a/gmloader/port_ext.cpp b/gmloader/port_ext.cpp
new file mode 100644
index 0000000..a18a8a6
--- /dev/null
+++ b/gmloader/port_ext.cpp
@@ -0,0 +1,1241 @@
+/*
+ * Handheld port layer for GameMaker Android games (gmloader-next).
+ *
+ *  - Java extension emulation (RunnerJNILib.CallExtensionFunction) for the
+ *    extensions shipped in the APK (storage folders, file picker, sharing).
+ *  - HTTP/HTTPS for http_get / http_post_string / http_request (libcurl +
+ *    mbedTLS), results delivered as the Android runner does.
+ *  - get_string_async / get_login_async / show_message_async /
+ *    show_question_async and the virtual keyboard, drawn by port_ui.cpp.
+ *  - Display option: keep aspect ratio (option_scale).
+ */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <errno.h>
+#include <unistd.h>
+#include <pthread.h>
+#include <ifaddrs.h>
+#include <net/if.h>
+#include <netinet/in.h>
+#include <sys/stat.h>
+#include <sys/types.h>
+
+#include <string>
+#include <vector>
+#include <deque>
+#include <mutex>
+#include <condition_variable>
+#include <functional>
+
+#include <curl/curl.h>
+#include <SDL2/SDL.h>
+
+#include "platform.h"
+#include "so_util.h"
+#include "jni.h"
+#include "jni_internals.h"
+#include "libyoyo.h"
+#include "classes/RunnerJNILib.h"
+#include "jni/classes/lang.h"
+#include "port.h"
+#include "port_jni.h"
+
+#define LOG(...) do { fprintf(stderr, "[port] " __VA_ARGS__); } while (0)
+
+/* ------------------------------------------------------------------------ */
+/* Globals                                                                  */
+/* ------------------------------------------------------------------------ */
+/* URLs in log.txt: no query string (tokens, signatures, user data) */
+static std::string log_url(const std::string &u)
+{
+    size_t q = u.find('?');
+    return q == std::string::npos ? u : u.substr(0, q) + "?...";
+}
+
+static JNIEnv *g_env = NULL;
+static so_module *g_yoyo = NULL;
+static std::string g_storage_root;   /* Android "internal storage" (/sdcard)  */
+static std::string g_files_dir;      /* getExternalFilesDir(null)              */
+static std::string g_import_dir;     /* files offered by the file picker       */
+static std::string g_ca_file;
+static int *g_option_scale = NULL;
+static int g_keep_aspect = 0;
+static char *g_io_input_string = NULL;
+static int *g_io_last_char = NULL;
+
+typedef void (*n_HttpResult_t)(JNIEnv *, jclass, jbyteArray, jint, jint, jstring, jstring);
+typedef void (*n_HttpResultString_t)(JNIEnv *, jclass, jstring, jint, jint);
+typedef void (*n_InputResult_t)(JNIEnv *, jclass, jstring, jint, jint);
+typedef void (*n_LoginResult_t)(JNIEnv *, jclass, jstring, jstring, jint);
+typedef void (*n_VKStatus_t)(JNIEnv *, jclass, jstring, jint);
+typedef void (*n_VKText_t)(JNIEnv *, jclass, jintArray, jint);
+typedef void (*n_KeyEvent_t)(JNIEnv *, jclass, jint, jint, jint, jint, jint);
+
+static n_HttpResult_t       n_HttpResult = NULL;
+static n_HttpResultString_t n_HttpResultString = NULL;
+static n_InputResult_t      n_InputResult = NULL;
+static n_LoginResult_t      n_LoginResult = NULL;
+static n_VKStatus_t         n_VKStatus = NULL;
+static n_VKText_t           n_VKText = NULL;
+static n_KeyEvent_t         n_KeyEvent = NULL;
+
+#include "configuration.h"
+extern "C" const char *port_save_dir_cstr(void) { return gmloader_config.save_dir.c_str(); }
+
+const std::string &port_storage_root() { return g_storage_root; }
+const std::string &port_files_dir() { return g_files_dir; }
+
+static void mkdir_p(const std::string &path)
+{
+    std::string cur;
+    size_t i = 0;
+    while (i <= path.size()) {
+        size_t j = path.find('/', i);
+        if (j == std::string::npos) j = path.size();
+        cur = path.substr(0, j);
+        if (!cur.empty())
+            mkdir(cur.c_str(), 0755);
+        i = j + 1;
+    }
+}
+
+static std::string env_or(const char *name, const std::string &def)
+{
+    const char *v = getenv(name);
+    return (v && *v) ? std::string(v) : def;
+}
+
+static std::string cwd()
+{
+    char buf[4096];
+    if (getcwd(buf, sizeof(buf)) == NULL)
+        return ".";
+    return buf;
+}
+
+/* JNI helpers (this JNI never frees; release what we allocate ourselves). */
+static String *mkstr(const char *s)
+{
+    return new String(s ? s : "");
+}
+
+static void freestr(String *s)
+{
+    if (!s) return;
+    ::free(s->str);
+    delete s;
+}
+
+static ArrayObject *mkbytes(const void *data, size_t len)
+{
+    ArrayObject *a = (ArrayObject *)calloc(1, sizeof(ArrayObject));
+    a->count = (jsize)len;
+    a->element_size = 1;
+    a->elements = malloc(len ? len : 1);
+    if (len) memcpy(a->elements, data, len);
+    return a;
+}
+
+static ArrayObject *mkints(const std::vector<int> &v)
+{
+    ArrayObject *a = (ArrayObject *)calloc(1, sizeof(ArrayObject));
+    a->count = (jsize)v.size();
+    a->element_size = sizeof(jint);
+    a->elements = calloc(v.size() ? v.size() : 1, sizeof(jint));
+    if (!v.empty()) memcpy(a->elements, v.data(), v.size() * sizeof(jint));
+    return a;
+}
+
+static void freearr(ArrayObject *a)
+{
+    if (!a) return;
+    ::free(a->elements);
+    ::free(a);
+}
+
+static const char *jstr(jstring s)
+{
+    return s ? ((String *)s)->str : "";
+}
+
+/* UTF-8 <-> code points */
+static std::vector<int> utf8_to_cp(const std::string &s)
+{
+    std::vector<int> out;
+    for (size_t i = 0; i < s.size();) {
+        unsigned char c = s[i];
+        int cp, n;
+        if (c < 0x80) { cp = c; n = 1; }
+        else if ((c >> 5) == 6) { cp = c & 0x1f; n = 2; }
+        else if ((c >> 4) == 14) { cp = c & 0x0f; n = 3; }
+        else if ((c >> 3) == 30) { cp = c & 0x07; n = 4; }
+        else { i++; continue; }
+        if (i + n > s.size()) break;
+        for (int k = 1; k < n; k++) cp = (cp << 6) | (s[i + k] & 0x3f);
+        out.push_back(cp);
+        i += n;
+    }
+    return out;
+}
+
+static std::string cp_to_utf8(const jint *cp, int n)
+{
+    std::string s;
+    for (int i = 0; i < n; i++) {
+        unsigned c = (unsigned)cp[i];
+        if (c == 0) break;
+        if (c < 0x80) s += (char)c;
+        else if (c < 0x800) { s += (char)(0xc0 | (c >> 6)); s += (char)(0x80 | (c & 0x3f)); }
+        else if (c < 0x10000) { s += (char)(0xe0 | (c >> 12)); s += (char)(0x80 | ((c >> 6) & 0x3f)); s += (char)(0x80 | (c & 0x3f)); }
+        else { s += (char)(0xf0 | (c >> 18)); s += (char)(0x80 | ((c >> 12) & 0x3f)); s += (char)(0x80 | ((c >> 6) & 0x3f)); s += (char)(0x80 | (c & 0x3f)); }
+    }
+    return s;
+}
