+static void draw_dialog(float w, float h)
+{
+    ImGuiWindowFlags fl = ImGuiWindowFlags_NoDecoration | ImGuiWindowFlags_NoMove | ImGuiWindowFlags_NoSavedSettings | ImGuiWindowFlags_NoNav;
+    float top_h = vk_visible ? (h - vk_height_px) : h;
