+extern void input_inject_key(int vk, int ch);
+void port_key_event(int down, int keycode, int ch)
+{
+    (void)down;
+    (void)keycode;
+    /* Enter / Backspace become key presses; text goes to keyboard_string
+       (letters are not sent as keys, they could trigger game controls). */
+    if (ch == 13) input_inject_key(13, 13);
+    else if (ch == 8) input_inject_key(8, 8);
+    else if (g_io_last_char && ch > 0 && ch < 256) *g_io_last_char = ch;
+}
