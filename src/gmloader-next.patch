+/* ------------------------------------------------------------------------ */
+/* Main-thread task queue (results from worker threads)                     */
+/* ------------------------------------------------------------------------ */
+static std::mutex g_main_mtx;
+static std::deque<std::function<void()>> g_main_tasks;
+
+static void run_on_main(std::function<void()> fn)
+{
+    std::lock_guard<std::mutex> lk(g_main_mtx);
+    g_main_tasks.push_back(std::move(fn));
+}
