+/* ------------------------------------------------------------------------ */
+/* Network status                                                           */
+/* ------------------------------------------------------------------------ */
+bool port_network_up()
+{
+    struct ifaddrs *ifa = NULL, *i;
+    bool up = false;
+    if (getifaddrs(&ifa) != 0)
+        return true; /* unknown: let the game try */
+    for (i = ifa; i; i = i->ifa_next) {
+        if (!i->ifa_addr || (i->ifa_flags & IFF_LOOPBACK) || !(i->ifa_flags & IFF_UP))
+            continue;
+        if (i->ifa_addr->sa_family == AF_INET || i->ifa_addr->sa_family == AF_INET6) {
+            up = true;
+            break;
+        }
+    }
+    freeifaddrs(ifa);
+    return up;
+}
