+/* ------------------------------------------------------------------------ */
+/* HTTP                                                                     */
+/* ------------------------------------------------------------------------ */
+struct HttpJob {
+    int id;
+    std::string url, method, headers;
+    std::vector<char> body;
+};
+
+static std::mutex g_http_mtx;
+static std::condition_variable g_http_cv;
+static std::deque<HttpJob> g_http_jobs;
+static int g_http_threads = 0;
+
+static size_t http_write(char *ptr, size_t sz, size_t nm, void *ud)
+{
+    std::vector<char> *v = (std::vector<char> *)ud;
+    v->insert(v->end(), ptr, ptr + sz * nm);
+    return sz * nm;
+}
+
+static size_t http_header(char *ptr, size_t sz, size_t nm, void *ud)
+{
+    std::string *h = (std::string *)ud;
+    std::string line(ptr, sz * nm);
+    while (!line.empty() && (line.back() == '\n' || line.back() == '\r'))
+        line.pop_back();
+    if (line.empty())
+        return sz * nm;
+    if (line.compare(0, 5, "HTTP/") == 0) {
+        /* new response (redirect): restart the header list */
+        *h = "nokey: " + line + "\n";
+    } else {
+        *h += line + "\n";
+    }
+    return sz * nm;
+}
+
+static void http_run(HttpJob &job)
+{
+    std::vector<char> data;
+    std::string rheaders;
+    long status = 0;
+    char err[CURL_ERROR_SIZE] = {0};
+
+    CURL *c = curl_easy_init();
+    if (!c) {
+        int id = job.id;
+        run_on_main([id]() {
+            String *s = mkstr("IOException");
+            if (n_HttpResultString) n_HttpResultString(g_env, NULL, (jstring)s, 404, id);
+            freestr(s);
+        });
+        return;
+    }
+
+    struct curl_slist *hl = NULL;
+    size_t p = 0;
+    while (p < job.headers.size()) {
+        size_t e = job.headers.find_first_of("\r\n", p);
+        if (e == std::string::npos) e = job.headers.size();
+        std::string line = job.headers.substr(p, e - p);
+        if (line.find(':') != std::string::npos)
+            hl = curl_slist_append(hl, line.c_str());
+        p = e + 1;
+    }
+    /* Java's HttpURLConnection does not send "Expect: 100-continue" */
+    hl = curl_slist_append(hl, "Expect:");
+
+    curl_easy_setopt(c, CURLOPT_URL, job.url.c_str());
+    curl_easy_setopt(c, CURLOPT_HTTPHEADER, hl);
+    curl_easy_setopt(c, CURLOPT_FOLLOWLOCATION, 1L);
+    curl_easy_setopt(c, CURLOPT_MAXREDIRS, 8L);
+    curl_easy_setopt(c, CURLOPT_NOSIGNAL, 1L);
+    curl_easy_setopt(c, CURLOPT_CONNECTTIMEOUT, 15L);
+    curl_easy_setopt(c, CURLOPT_TIMEOUT, 120L);
+    curl_easy_setopt(c, CURLOPT_LOW_SPEED_LIMIT, 1L);
+    curl_easy_setopt(c, CURLOPT_LOW_SPEED_TIME, 30L);
+    curl_easy_setopt(c, CURLOPT_ACCEPT_ENCODING, "");
+    curl_easy_setopt(c, CURLOPT_USERAGENT, "Dalvik/2.1.0 (Linux; U; Android 11; Handheld)");
+    curl_easy_setopt(c, CURLOPT_WRITEFUNCTION, http_write);
+    curl_easy_setopt(c, CURLOPT_WRITEDATA, &data);
+    curl_easy_setopt(c, CURLOPT_HEADERFUNCTION, http_header);
+    curl_easy_setopt(c, CURLOPT_HEADERDATA, &rheaders);
+    curl_easy_setopt(c, CURLOPT_ERRORBUFFER, err);
+    if (!g_ca_file.empty())
+        curl_easy_setopt(c, CURLOPT_CAINFO, g_ca_file.c_str());
+    if (getenv("PORT_HTTP_INSECURE") && atoi(getenv("PORT_HTTP_INSECURE"))) {
+        curl_easy_setopt(c, CURLOPT_SSL_VERIFYPEER, 0L);
+        curl_easy_setopt(c, CURLOPT_SSL_VERIFYHOST, 0L);
+    }
+
+    const std::string &m = job.method;
+    if (m == "GET") {
+        curl_easy_setopt(c, CURLOPT_HTTPGET, 1L);
+    } else if (m == "HEAD") {
+        curl_easy_setopt(c, CURLOPT_NOBODY, 1L);
+    } else {
+        if (m != "POST")
+            curl_easy_setopt(c, CURLOPT_CUSTOMREQUEST, m.c_str());
+        curl_easy_setopt(c, CURLOPT_POST, 1L);
+        curl_easy_setopt(c, CURLOPT_POSTFIELDSIZE, (long)job.body.size());
+        curl_easy_setopt(c, CURLOPT_POSTFIELDS, job.body.empty() ? "" : job.body.data());
+    }
+
+    CURLcode rc = curl_easy_perform(c);
+    curl_easy_getinfo(c, CURLINFO_RESPONSE_CODE, &status);
+    char *eff = NULL;
+    curl_easy_getinfo(c, CURLINFO_EFFECTIVE_URL, &eff);
+    std::string final_url = eff ? eff : job.url;
+    curl_slist_free_all(hl);
+    curl_easy_cleanup(c);
+
+    int id = job.id;
+    if (rc != CURLE_OK) {
+        LOG("http %d %s %s failed: %s (%s)\n", id, m.c_str(), log_url(job.url).c_str(), curl_easy_strerror(rc), err);
+        const char *what = (rc == CURLE_OPERATION_TIMEDOUT) ? "HTTP request timed out" : "IOException";
+        std::string w = what;
+        run_on_main([id, w]() {
+            String *s = mkstr(w.c_str());
+            if (n_HttpResultString) n_HttpResultString(g_env, NULL, (jstring)s, 404, id);
+            freestr(s);
+        });
+        return;
+    }
+
+    LOG("http %d %s %s -> %ld (%zu bytes)\n", id, m.c_str(), log_url(job.url).c_str(), status, data.size());
+    if (data.empty())
+        data.push_back(0);
+    run_on_main([id, status, data, final_url, rheaders]() {
+        ArrayObject *arr = mkbytes(data.data(), data.size());
+        String *u = mkstr(final_url.c_str());
+        String *h = mkstr(rheaders.c_str());
+        if (n_HttpResult) n_HttpResult(g_env, NULL, (jbyteArray)arr, (jint)status, id, (jstring)u, (jstring)h);
+        freearr(arr);
+        freestr(u);
+        freestr(h);
+    });
+}
+
+static void *http_worker(void *)
+{
+    for (;;) {
+        HttpJob job;
+        {
+            std::unique_lock<std::mutex> lk(g_http_mtx);
+            g_http_cv.wait(lk, [] { return !g_http_jobs.empty(); });
+            job = std::move(g_http_jobs.front());
+            g_http_jobs.pop_front();
+        }
+        http_run(job);
+    }
+    return NULL;
+}
+
+static void http_queue(HttpJob job)
+{
+    /* testing aid: PORT_HTTP_REWRITE="https://from=http://to" */
+    const char *rw = getenv("PORT_HTTP_REWRITE");
+    if (rw && strchr(rw, '=')) {
+        std::string r(rw), from = r.substr(0, r.find('=')), to = r.substr(r.find('=') + 1);
+        if (job.url.compare(0, from.size(), from) == 0)
+            job.url = to + job.url.substr(from.size());
+    }
+    std::lock_guard<std::mutex> lk(g_http_mtx);
+    if (g_http_threads == 0) {
+        curl_global_init(CURL_GLOBAL_DEFAULT);
+        const curl_version_info_data *vi = curl_version_info(CURLVERSION_NOW);
+        LOG("http: libcurl %s, %s, CA file '%s'\n", vi->version, vi->ssl_version ? vi->ssl_version : "no TLS", g_ca_file.c_str());
+    }
+    /* up to 4 parallel requests; low-priority threads keep the game smooth */
+    if (g_http_threads < 4 && g_http_threads <= (int)g_http_jobs.size()) {
+        pthread_t t;
+        pthread_attr_t at;
+        pthread_attr_init(&at);
+        pthread_attr_setstacksize(&at, 512 * 1024);
+        pthread_attr_setdetachstate(&at, PTHREAD_CREATE_DETACHED);
+        if (pthread_create(&t, &at, http_worker, NULL) == 0)
+            g_http_threads++;
+        pthread_attr_destroy(&at);
+    }
+    g_http_jobs.push_back(std::move(job));
+    g_http_cv.notify_one();
+}
