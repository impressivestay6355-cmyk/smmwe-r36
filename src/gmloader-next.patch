+static std::vector<std::string> split_ws(const char *s)
+{
+    std::vector<std::string> v;
+    std::string cur;
+    for (; *s; s++) {
+        if (*s == ' ') { if (!cur.empty()) v.push_back(cur); cur.clear(); }
+        else cur += *s;
+    }
+    if (!cur.empty()) v.push_back(cur);
+    return v;
+}
+
+static bool upper_now() { return vk_layer == 0 && (vk_shift || vk_caps); }
+
+static const char *key_label(const Key &k)
+{
+    if (k.act == K_TEXT) return upper_now() ? k.s : k.n;
+    if (k.act == K_SHIFT && vk_layer == 0) return vk_caps ? "CAPS" : (vk_shift ? "SHIFT" : "Shift");
+    return k.n;
+}
