diff --git a/thunks/libc/ci_files.cpp b/thunks/libc/ci_files.cpp
new file mode 100644
index 0000000..5c52a31
--- /dev/null
+++ b/thunks/libc/ci_files.cpp
@@ -0,0 +1,158 @@
+/*
+ * Case-insensitive file names in the game's save folders.
+ *
+ * The Android runner does not always use the same case for a file name
+ * (e.g. writes "Settings351.dat", later reads "settings351.dat"). Android's
+ * app storage tolerates it in practice, Linux does not: when a file is not
+ * found under the save / storage folders, look for a name that differs only
+ * in case and use that one instead.
+ */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <strings.h>
+#include <errno.h>
+#include <dirent.h>
+#include <unistd.h>
+#include <sys/stat.h>
+#include <string>
+
+#include "platform.h"
+
+extern "C" const char *port_save_dir_cstr(void);   /* gmloader/port_ext.cpp */
+
+static bool in_game_dirs(const char *path)
+{
+    if (!path || path[0] != '/') return false;
+    static std::string sd;
+    if (sd.empty() && port_save_dir_cstr() && *port_save_dir_cstr()) {
+        sd = port_save_dir_cstr();
+        if (sd[0] != '/') {
+            char cwd[4096];
+            if (getcwd(cwd, sizeof(cwd))) sd = std::string(cwd) + "/" + sd;
+        }
+        while (sd.size() > 1 && sd.back() == '/') sd.pop_back();
+    }
+    if (!sd.empty() && strncmp(path, sd.c_str(), sd.size()) == 0) return true;
+    const char *envs[] = {"PORT_STORAGE", "PORT_FILES"};
+    for (const char *e : envs) {
+        const char *d = getenv(e);
+        if (d && *d && strncmp(path, d, strlen(d)) == 0) return true;
+    }
+    return false;
+}
+
+/* Resolve every path component case-insensitively; true if it exists. */
+static bool ci_resolve(const char *path, std::string &out)
+{
+    if (!in_game_dirs(path)) return false;
+    std::string cur;
+    const char *p = path;
+    while (*p == '/') p++;
+    cur = "";
+    bool changed = false;
+    while (*p) {
+        const char *e = strchr(p, '/');
+        std::string comp = e ? std::string(p, e - p) : std::string(p);
+        std::string cand = cur + "/" + comp;
+        struct stat st;
+        if (::stat(cand.c_str(), &st) != 0) {
+            DIR *d = opendir(cur.empty() ? "/" : cur.c_str());
+            bool found = false;
+            if (d) {
+                struct dirent *de;
+                while ((de = readdir(d))) {
+                    if (strcasecmp(de->d_name, comp.c_str()) == 0) {
+                        cand = cur + "/" + de->d_name;
+                        found = true;
+                        changed = true;
+                        break;
+                    }
+                }
+                closedir(d);
+            }
+            if (!found) return false;
+        }
+        cur = cand;
+        if (!e) break;
+        p = e + 1;
+        while (*p == '/') p++;
+    }
+    if (!changed) return false;
+    out = cur;
+    return true;
+}
+
+extern "C" ABI_ATTR FILE *fopen_impl(const char *path, const char *mode)
+{
+    FILE *f = ::fopen(path, mode);
+    if (f || errno != ENOENT) return f;
+    std::string alt;
+    if (ci_resolve(path, alt)) {
+        f = ::fopen(alt.c_str(), mode);
+        if (!f) errno = ENOENT;
+    } else if (mode && mode[0] != 'r') {
+        /* creating: the parent folder may differ in case */
+        std::string dir(path), base;
+        size_t sl = dir.find_last_of('/');
+        if (sl != std::string::npos && sl > 0) {
+            base = dir.substr(sl);
+            dir = dir.substr(0, sl);
+            std::string adir;
+            if (ci_resolve(dir.c_str(), adir))
+                f = ::fopen((adir + base).c_str(), mode);
+        }
+        if (!f) errno = ENOENT;
+    }
+    return f;
+}
+
+extern "C" ABI_ATTR FILE *fopen64_impl(const char *path, const char *mode)
+{
+    return fopen_impl(path, mode);
+}
+
+extern "C" ABI_ATTR int stat_impl(const char *path, struct stat *st)
+{
+    int r = ::stat(path, st);
+    if (r == 0 || errno != ENOENT) return r;
+    std::string alt;
+    if (ci_resolve(path, alt)) return ::stat(alt.c_str(), st);
+    errno = ENOENT;
+    return -1;
+}
+
+extern "C" ABI_ATTR int access_impl(const char *path, int mode)
+{
+    int r = ::access(path, mode);
+    if (r == 0 || errno != ENOENT) return r;
+    std::string alt;
+    if (ci_resolve(path, alt)) return ::access(alt.c_str(), mode);
+    errno = ENOENT;
+    return -1;
+}
+
+extern "C" ABI_ATTR int remove_impl(const char *path)
+{
+    int r = ::remove(path);
+    if (r == 0 || errno != ENOENT) return r;
+    std::string alt;
+    if (ci_resolve(path, alt)) return ::remove(alt.c_str());
+    errno = ENOENT;
+    return -1;
+}
+
+extern "C" ABI_ATTR int unlink_impl(const char *path)
+{
+    int r = ::unlink(path);
+    if (r == 0 || errno != ENOENT) return r;
+    std::string alt;
+    if (ci_resolve(path, alt)) return ::unlink(alt.c_str());
+    errno = ENOENT;
+    return -1;
+}
+
+extern "C" ABI_ATTR int stat64_impl(const char *path, struct stat *st)
+{
+    return stat_impl(path, st);
+}
