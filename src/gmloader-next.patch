+#pragma once
+#include "jni.h"
+#include "jni_internals.h"
+
+class JObject : public Object {
+public:
+    static Class clazz;
+    Class *_getClass() { return &clazz; }
+};
+
+class JDouble : public Object {
+public:
+    static Class clazz;
+    Class *_getClass() { return &clazz; }
+
+    double value;
+    JDouble(double v);
+
+    static void init(JNIEnv *env, jobject obj, jclass clz, jdouble v);
+    static jdouble doubleValue(JNIEnv *env, jobject obj);
+    static JDouble *make(double v);
+};
