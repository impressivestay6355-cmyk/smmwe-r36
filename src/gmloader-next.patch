+static void draw_keyboard(float w, float h)
+{
+    const auto &r = rows();
+    float kb_h = std::min(h * 0.50f, std::max(h * 0.40f, 170.0f));
+    vk_height_px = (int)kb_h;
+    ImGui::SetNextWindowPos(ImVec2(0, h - kb_h));
+    ImGui::SetNextWindowSize(ImVec2(w, kb_h));
+    ImGui::SetNextWindowBgAlpha(0.94f);
+    ImGuiWindowFlags fl = ImGuiWindowFlags_NoDecoration | ImGuiWindowFlags_NoMove | ImGuiWindowFlags_NoSavedSettings |
+                          ImGuiWindowFlags_NoFocusOnAppearing | ImGuiWindowFlags_NoNav;
+    ImGui::PushStyleVar(ImGuiStyleVar_WindowPadding, ImVec2(4, 4));
+    ImGui::PushStyleVar(ImGuiStyleVar_ItemSpacing, ImVec2(4, 4));
+    ImGui::PushStyleVar(ImGuiStyleVar_WindowRounding, 0);
+    if (ImGui::Begin("##vk", NULL, fl)) {
+        float pad = 4, gap = 4;
+        float hint_h = g_font_px * 0.85f + 2;
+        float key_h = (kb_h - pad * 2 - gap * (r.size() - 1) - hint_h) / (float)r.size();
+        float usable = w - pad * 2;
+        for (int row = 0; row < (int)r.size(); row++) {
+            float units = 0;
+            for (auto &k : r[row]) units += k.w;
+            float unit_w = (usable - gap * (r[row].size() - 1)) / units;
+            ImGui::SetCursorPosX(pad);
+            for (int col = 0; col < (int)r[row].size(); col++) {
+                const Key &k = r[row][col];
+                bool sel = (row == vk_cur_row && col == vk_cur_col);
+                bool act = (k.act == K_SHIFT && vk_layer == 0 && (vk_shift || vk_caps));
+                if (sel) {
+                    ImGui::PushStyleColor(ImGuiCol_Button, ImVec4(0.10f, 0.62f, 0.88f, 1.0f));
+                    ImGui::PushStyleColor(ImGuiCol_ButtonHovered, ImVec4(0.14f, 0.68f, 0.95f, 1.0f));
+                } else if (act || k.act == K_ENTER) {
+                    ImGui::PushStyleColor(ImGuiCol_Button, ImVec4(0.18f, 0.36f, 0.50f, 1.0f));
+                    ImGui::PushStyleColor(ImGuiCol_ButtonHovered, ImVec4(0.22f, 0.42f, 0.58f, 1.0f));
+                }
+                char id[64];
+                snprintf(id, sizeof(id), "%s##k%d_%d", key_label(k), row, col);
+                if (ImGui::Button(id, ImVec2(unit_w * k.w, key_h))) {
+                    vk_cur_row = row; vk_cur_col = col;
+                    vk_press(k);
+                }
+                if (sel || act || k.act == K_ENTER) ImGui::PopStyleColor(2);
+                if (col + 1 < (int)r[row].size()) ImGui::SameLine();
+            }
+        }
+        ImGui::SetCursorPosX(pad + 2);
+        ImGui::TextDisabled("A type (hold: accents)  B del  X space  Y shift  L1/R1 layout  L2/R2 move  START enter  SELECT cancel");
+    }
+    ImGui::End();
+    ImGui::PopStyleVar(3);
+
+    if (vk_popup && !vk_variants.empty()) {
+        int n = (int)vk_variants.size();
+        float bw = g_font_px * 2.0f;
+        float pw = std::min(w - 8, n * (bw + 4) + 12);
+        ImGui::SetNextWindowPos(ImVec2((w - pw) * 0.5f, std::max(4.0f, h - kb_h - g_font_px * 2 - 28 - bw - 24)));
+        ImGui::SetNextWindowSize(ImVec2(pw, bw + 18));
+        if (ImGui::Begin("##vkvar", NULL, fl)) {
+            for (int i = 0; i < n; i++) {
+                bool sel = i == vk_variant_idx;
+                if (sel) ImGui::PushStyleColor(ImGuiCol_Button, ImVec4(0.10f, 0.62f, 0.88f, 1.0f));
+                char id[32];
+                snprintf(id, sizeof(id), "%s##v%d", vk_variants[i].c_str(), i);
+                if (ImGui::Button(id, ImVec2(bw, bw))) { vk_insert(vk_variants[i]); vk_popup = false; }
+                if (sel) ImGui::PopStyleColor();
+                if (i + 1 < n) ImGui::SameLine();
+            }
+        }
+        ImGui::End();
+    }
+}
