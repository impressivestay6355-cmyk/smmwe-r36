+/* Keys typed on the on-screen keyboard: pressed for one frame, released on
+   the next one, so keyboard_check_pressed() sees them. */
+static int inj_queue[64];
+static int inj_count = 0;
+static int inj_release[64];
+static int inj_release_count = 0;
+void input_inject_key(int vk, int ch)
+{
+    int key = vk;
+    if (key == 0) {
+        if (ch >= 'a' && ch <= 'z') key = ch - 'a' + 'A';
+        else if ((ch >= 'A' && ch <= 'Z') || (ch >= '0' && ch <= '9') || ch == ' ') key = ch;
+        else if (ch == 8) key = vk_backspace;
+    }
+    if (key > 0 && key < N_KEYS && inj_count < 64)
+        inj_queue[inj_count++] = key;
+}
+
+static void apply_injected_keys()
+{
+    for (int i = 0; i < inj_release_count; i++)
+        keyboard_set_key_raw(inj_release[i], 0);
+    inj_release_count = 0;
+    for (int i = 0; i < inj_count; i++) {
+        keyboard_set_key_raw(inj_queue[i], 1);
+        inj_release[inj_release_count++] = inj_queue[i];
+    }
+    inj_count = 0;
+}
+
+/* keyboard_key_press/release() from the game (this game turns the gamepad
+   into keys with them, every frame while a button is held). As on Android,
+   they are queued and applied at the start of the next frame: "pressed" and
+   "released" only on a real change, so Key Press events (e.g. START = Enter
+   = pause) fire once and are not cleared before the game sees them. */
+static int gk_key[256];
+static unsigned char gk_down[256];
+static int gk_count = 0;
 ABI_ATTR void RegisterAndroidKeyEvent(int state, int key)
 {
-    keyboard_set_key_raw(key, state ? 0 : 1);
-    printf("RegisterAndroidKeyEvent(%d, %d)\n", state, key);
+    if (key > 0 && key < N_KEYS && gk_count < 256) {
+        gk_key[gk_count] = key;
+        gk_down[gk_count] = state ? 0 : 1;
+        gk_count++;
+    }
+}
+
+static void apply_game_keys()
+{
+    for (int i = 0; i < gk_count; i++) {
+        int key = gk_key[i];
+        int down = gk_down[i];
+        if (down) {
+            if (!_IO_KeyDown[key]) _IO_KeyPressed[key] = 1;
+            _IO_KeyDown[key] = 1;
+            *_IO_CurrentKey = key;
+        } else {
+            if (_IO_KeyDown[key]) _IO_KeyReleased[key] = 1;
+            _IO_KeyDown[key] = 0;
+            if (*_IO_CurrentKey == key) *_IO_CurrentKey = -1;
+        }
+    }
+    gk_count = 0;
 }
 
