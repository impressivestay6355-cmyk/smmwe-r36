+/* log the audio volume state (listener gain, the game's own setting) */
+static void audio_diag()
+{
+    typedef float (*lgain_t)(int);
+    lgain_t lg = (lgain_t)so_symbol(g_yoyo, "_Z21Audio_ListenerGetGaini");
+    char buf[64] = "?";
+    if (Code_Variable_Find_Slot_From_Name && Variable_GetValue_Direct && g_pGlobal && *g_pGlobal) {
+        int slot = Code_Variable_Find_Slot_From_Name(*g_pGlobal, "audiomaster");
+        if (slot >= 0) {
+            RValue v;
+            memset(&v, 0, sizeof(v));
+            Variable_GetValue_Direct(*g_pGlobal, slot, (int)0x80000000, &v, 0, 0);
+            fmt_rvalue(&v, buf, sizeof(buf));
+        }
+    }
+    LOG("audio: listener gain %.3f, game volume (audiomaster) %s\n", lg ? lg(0) : -1.0f, buf);
+}
+
+/* PORT_TEST_SOUND="idx[,idx...]": play these sounds at frame 60 (debug) */
+static void test_sounds()
+{
+    const char *env = getenv("PORT_TEST_SOUND");
+    if (!env) return;
+    RunnerFunc **tab = (RunnerFunc **)so_symbol(g_yoyo, "the_functions");
+    int *numb = (int *)so_symbol(g_yoyo, "the_numb");
+    if (!tab || !*tab || !numb) return;
+    routine_t play = NULL;
+    for (int i = 0; i < *numb; i++)
+        if ((*tab)[i].name && !strcmp((*tab)[i].name, "audio_play_sound")) { play = (*tab)[i].fn; break; }
+    if (!play) return;
+    std::string l = env;
+    size_t p = 0;
+    while (p < l.size()) {
+        size_t e = l.find(',', p);
+        if (e == std::string::npos) e = l.size();
+        int idx = atoi(l.substr(p, e - p).c_str());
+        RValue args[3];
+        memset(args, 0, sizeof(args));
+        args[0].kind = VALUE_REAL; args[0].rvalue.val = idx;
+        args[1].kind = VALUE_REAL; args[1].rvalue.val = 10;
+        args[2].kind = VALUE_REAL; args[2].rvalue.val = 0;
+        RValue ret;
+        memset(&ret, 0, sizeof(ret));
+        play(&ret, NULL, NULL, 3, args);
+        LOG("test sound %d -> %g\n", idx, ret.kind == VALUE_REAL ? ret.rvalue.val : -1.0);
+        p = e + 1;
+    }
+}
+
+/* frame rate in log.txt every 30 s (and on screen with PORT_SHOW_FPS=1) */
+static float g_fps_now = 0;
+float port_fps() { return g_fps_now; }
+static void fps_stats()
+{
+    static Uint32 last = 0, win_start = 0, sec_start = 0;
+    static int win_frames = 0, slow = 0, sec_frames = 0;
+    static Uint32 worst = 0;
+    Uint32 now = SDL_GetTicks();
+    if (!last) { last = win_start = sec_start = now; return; }
+    Uint32 dt = now - last;
+    last = now;
+    win_frames++; sec_frames++;
+    if (dt > 20) slow++;
+    if (dt > worst) worst = dt;
+    if (now - sec_start >= 1000) {
+        g_fps_now = sec_frames * 1000.0f / (now - sec_start);
+        sec_frames = 0; sec_start = now;
+    }
+    if (now - win_start >= 30000) {
+        LOG("fps %.1f, slow frames (>20 ms) %d%%, worst %u ms\n",
+            win_frames * 1000.0 / (now - win_start), win_frames ? slow * 100 / win_frames : 0, worst);
+        win_start = now; win_frames = 0; slow = 0; worst = 0;
+    }
+}
+
+void port_frame_begin()
+{
+    static int frames = 0;
+    fps_stats();
+    if (++frames == 2 || frames == 120)   /* in case the table is filled late */
+        fix_function_table();
+    if (frames == 60) {
+        test_sounds();
+        audio_kick();
+    }
+    if (frames == 300)
+        dump_globals();
+    if (frames == 600 || frames == 3600)
+        audio_diag();
+    if (frames % 30 == 0)
+        touch_controls_off();
+    std::deque<std::function<void()>> tasks;
+    {
+        std::lock_guard<std::mutex> lk(g_main_mtx);
+        tasks.swap(g_main_tasks);
+    }
+    for (auto &t : tasks)
+        t();
+}
