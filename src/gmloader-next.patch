+static routine_t find_runner_fn(const char *name)
+{
+    RunnerFunc **tab = (RunnerFunc **)so_symbol(g_yoyo, "the_functions");
+    int *numb = (int *)so_symbol(g_yoyo, "the_numb");
+    if (!tab || !*tab || !numb) return NULL;
+    for (int i = 0; i < *numb; i++)
+        if ((*tab)[i].name && !strcmp((*tab)[i].name, name)) return (*tab)[i].fn;
+    return NULL;
+}
+
+/* On the handheld the game's audio stays silent unless a sound is started
+   early, before the first room (seen on device, not in the emulator).
+   Start two of the game's own sounds (one in memory, one streamed) at zero
+   volume. PORT_AUDIO_KICK=0 disables it. */
+static void audio_kick()
+{
+    if (getenv("PORT_AUDIO_KICK") && !atoi(getenv("PORT_AUDIO_KICK"))) return;
+    if (getenv("PORT_TEST_SOUND")) return;
+    routine_t play = find_runner_fn("audio_play_sound");
+    routine_t gain = find_runner_fn("audio_sound_gain");
+    if (!play || !gain) return;
+    const int ids[2] = {3, 206};
+    for (int i = 0; i < 2; i++) {
+        RValue a[3], r;
+        memset(a, 0, sizeof(a));
+        memset(&r, 0, sizeof(r));
+        a[0].kind = VALUE_REAL; a[0].rvalue.val = ids[i];
+        a[1].kind = VALUE_REAL; a[1].rvalue.val = 0;
+        a[2].kind = VALUE_REAL; a[2].rvalue.val = 0;
+        play(&r, NULL, NULL, 3, a);
+        if (r.kind != VALUE_REAL || r.rvalue.val < 0) continue;
+        RValue g[3], gr;
+        memset(g, 0, sizeof(g));
+        memset(&gr, 0, sizeof(gr));
+        g[0].kind = VALUE_REAL; g[0].rvalue.val = r.rvalue.val;   /* this instance only */
+        g[1].kind = VALUE_REAL; g[1].rvalue.val = 0;
+        g[2].kind = VALUE_REAL; g[2].rvalue.val = 0;
+        gain(&gr, NULL, NULL, 3, g);
+    }
+    LOG("audio started\n");
+}
+
+/* real("") throws in GameMaker; on Android the game always finds its data
+   files, here a missing one (e.g. the Endless Challenge save) would end the
+   game. Return 0 for an empty string instead. */
+static routine_t orig_real = NULL;
+ABI_ATTR static void safe_real(RValue *ret, void *self, void *other, int argc, RValue *args)
+{
+    if (argc >= 1 && (args[0].kind & 0xffffff) == VALUE_STRING) {
+        const char *s = (args[0].rvalue.str && args[0].rvalue.str->m_thing) ? (const char *)args[0].rvalue.str->m_thing : "";
+        while (*s == ' ' || *s == '\t' || *s == '\r' || *s == '\n') s++;
+        if (*s == 0) {
+            ret->kind = VALUE_REAL;
+            ret->rvalue.val = 0;
+            return;
+        }
+    }
+    orig_real(ret, self, other, argc, args);
+}
+
+static void install_safe_real()
+{
+    RunnerFunc **tab = (RunnerFunc **)so_symbol(g_yoyo, "the_functions");
+    int *numb = (int *)so_symbol(g_yoyo, "the_numb");
+    if (!tab || !*tab || !numb) return;
+    for (int i = 0; i < *numb; i++) {
+        RunnerFunc *e = &(*tab)[i];
+        if (e->name && !strcmp(e->name, "real") && e->fn != safe_real) {
+            orig_real = e->fn;
+            e->fn = safe_real;
+            return;
+        }
+    }
+}
