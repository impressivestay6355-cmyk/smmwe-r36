+/* ------------------------------------------------------------------------ */
+/* Text editing                                                             */
+/* ------------------------------------------------------------------------ */
+static std::string *edit_target()
+{
+    if (dlg == PD_INPUT) return &dlg_field[0];
+    if (dlg == PD_LOGIN) return &dlg_field[dlg_focus];
+    return &vk_text;
+}
+
+static size_t utf8_prev(const std::string &s, size_t i)
+{
+    if (i == 0) return 0;
+    i--;
+    while (i > 0 && ((unsigned char)s[i] & 0xc0) == 0x80) i--;
+    return i;
+}
+
+static size_t utf8_next(const std::string &s, size_t i)
+{
+    if (i >= s.size()) return s.size();
+    i++;
+    while (i < s.size() && ((unsigned char)s[i] & 0xc0) == 0x80) i++;
+    return i;
+}
+
+static void text_changed()
+{
+    if (dlg != PD_NONE)
+        return;
+    /* keyboard opened by the game or manually: forward to keyboard_string */
+    port_vk_text(vk_text);
+}
+
+static void vk_insert(const std::string &s)
+{
+    std::string *t = edit_target();
+    if (vk_caret > t->size()) vk_caret = t->size();
+    if (t->size() + s.size() > 1000) return;
+    t->insert(vk_caret, s);
+    vk_caret += s.size();
+    text_changed();
+    if (dlg == PD_NONE) {
+        unsigned char c = (unsigned char)s[0];
+        port_key_event(1, 0, (s.size() == 1) ? c : 0);
+    }
+    if (vk_shift && !vk_caps) vk_shift = false;
+}
+
+static void vk_backspace()
+{
+    std::string *t = edit_target();
+    if (vk_caret > t->size()) vk_caret = t->size();
+    if (vk_caret == 0) return;
+    size_t p = utf8_prev(*t, vk_caret);
+    t->erase(p, vk_caret - p);
+    vk_caret = p;
+    text_changed();
+    if (dlg == PD_NONE)
+        port_key_event(1, 67, 8);
+}
