+static void install_safe_real();
+void port_after_startup()
+{
+    fix_function_table();
+    install_safe_real();
+    install_traces();
+    if (g_option_scale) {
+        LOG("option_scale from game: %d\n", *g_option_scale);
+        /* the "Keep Aspect Ratio" APK sets -1; the letterbox is done by the
+           loader (PORT_KEEP_ASPECT), so the game always draws full scale */
+        *g_option_scale = 0;
+    }
+}
