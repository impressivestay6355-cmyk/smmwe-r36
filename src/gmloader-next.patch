+
+/* ------------------------------------------------------------------------ */
+/* Keep aspect ratio: the game renders into a centered 16:9 area of the     */
+/* default framebuffer (viewport/scissor offset), bars are cleared black.   */
+/* ------------------------------------------------------------------------ */
+static int ar_on = 0, ar_ox = 0, ar_oy = 0, ar_w = 0, ar_h = 0, ar_win_w = 0, ar_win_h = 0;
+static int ar_num = 16, ar_den = 9;
+static GLuint ar_cur_fb = 0;
+static PFNGLVIEWPORTPROC real_viewport = NULL;
+static PFNGLSCISSORPROC real_scissor = NULL;
+static PFNGLBINDFRAMEBUFFERPROC real_bindfb = NULL;
+
+static void hk_viewport(GLint x, GLint y, GLsizei w, GLsizei h)
+{
+    if (ar_on && ar_cur_fb == 0) { x += ar_ox; y += ar_oy; }
+    real_viewport(x, y, w, h);
+}
+
+static void hk_scissor(GLint x, GLint y, GLsizei w, GLsizei h)
+{
+    if (ar_on && ar_cur_fb == 0) { x += ar_ox; y += ar_oy; }
+    real_scissor(x, y, w, h);
+}
+
+static void hk_bindfb(GLenum target, GLuint fb)
+{
+    if (target == GL_FRAMEBUFFER) ar_cur_fb = fb;
+    real_bindfb(target, fb);
+}
+
+extern DynLibFunction symtable_gles2[];
+static void ar_install_hooks()
+{
+    for (int i = 0; symtable_gles2[i].symbol; i++) {
+        const char *n = symtable_gles2[i].symbol;
+        if (!strcmp(n, "glViewport")) { real_viewport = (PFNGLVIEWPORTPROC)symtable_gles2[i].func; symtable_gles2[i].func = (uintptr_t)&hk_viewport; }
+        else if (!strcmp(n, "glScissor")) { real_scissor = (PFNGLSCISSORPROC)symtable_gles2[i].func; symtable_gles2[i].func = (uintptr_t)&hk_scissor; }
+        else if (!strcmp(n, "glBindFramebuffer")) { real_bindfb = (PFNGLBINDFRAMEBUFFERPROC)symtable_gles2[i].func; symtable_gles2[i].func = (uintptr_t)&hk_bindfb; }
+    }
+    if (!real_viewport || !real_scissor || !real_bindfb) {
+        LOG("aspect: GL hooks unavailable, keeping fullscreen\n");
+        ar_on = 0;
+    }
+}
+
+/* window size -> size reported to the game */
+void port_game_size(int win_w, int win_h, int *gw, int *gh)
+{
+    if (!ar_on || win_w <= 0 || win_h <= 0) {
+        *gw = win_w; *gh = win_h;
+        ar_ox = ar_oy = 0;
+        return;
+    }
+    if (win_w != ar_win_w || win_h != ar_win_h) {
+        ar_win_w = win_w; ar_win_h = win_h;
+        if ((long)win_w * ar_den > (long)win_h * ar_num) { ar_h = win_h; ar_w = (int)((long)win_h * ar_num / ar_den); }
+        else { ar_w = win_w; ar_h = (int)((long)win_w * ar_den / ar_num); }
+        ar_ox = (win_w - ar_w) / 2;
+        ar_oy = (win_h - ar_h) / 2;
+        LOG("aspect %d:%d -> game area %dx%d at %d,%d\n", ar_num, ar_den, ar_w, ar_h, ar_ox, ar_oy);
+    }
+    *gw = ar_w; *gh = ar_h;
+}
+
+/* window (top-left origin) -> game coordinates */
+void port_map_mouse(int *x, int *y)
+{
+    if (!ar_on) return;
+    int top = ar_win_h - ar_oy - ar_h;   /* GL y offset is from the bottom */
+    *x -= ar_ox;
+    *y -= top;
+    if (*x < 0) *x = 0;
+    if (*y < 0) *y = 0;
+    if (*x > ar_w - 1) *x = ar_w - 1;
+    if (*y > ar_h - 1) *y = ar_h - 1;
+}
+
+static void ar_clear_bars(int win_w, int win_h)
+{
+    if (!ar_on || (ar_ox == 0 && ar_oy == 0)) return;
+    GLint fbo = 0;
+    glGetIntegerv(GL_FRAMEBUFFER_BINDING, &fbo);
+    GLboolean sc = glIsEnabled(GL_SCISSOR_TEST);
+    GLint box[4];
+    GLfloat cc[4];
+    GLboolean cm[4];
+    glGetIntegerv(GL_SCISSOR_BOX, box);
+    glGetFloatv(GL_COLOR_CLEAR_VALUE, cc);
+    glGetBooleanv(GL_COLOR_WRITEMASK, cm);
+    if (fbo) real_bindfb(GL_FRAMEBUFFER, 0);
+    glEnable(GL_SCISSOR_TEST);
+    glColorMask(1, 1, 1, 1);
+    glClearColor(0, 0, 0, 1);
+    int top = win_h - ar_oy - ar_h;
+    if (ar_oy > 0) {
+        real_scissor(0, 0, win_w, ar_oy); glClear(GL_COLOR_BUFFER_BIT);
+        real_scissor(0, ar_oy + ar_h, win_w, top); glClear(GL_COLOR_BUFFER_BIT);
+    }
+    if (ar_ox > 0) {
+        real_scissor(0, 0, ar_ox, win_h); glClear(GL_COLOR_BUFFER_BIT);
+        real_scissor(ar_ox + ar_w, 0, win_w - ar_ox - ar_w, win_h); glClear(GL_COLOR_BUFFER_BIT);
+    }
+    real_scissor(box[0], box[1], box[2], box[3]);
+    if (!sc) glDisable(GL_SCISSOR_TEST);
+    glClearColor(cc[0], cc[1], cc[2], cc[3]);
+    glColorMask(cm[0], cm[1], cm[2], cm[3]);
+    if (fbo) real_bindfb(GL_FRAMEBUFFER, fbo);
+}
+
+/* ------------------------------------------------------------------------ */
+/* Layouts                                                                  */
+/* ------------------------------------------------------------------------ */
+static const std::vector<std::vector<Key>> &rows()
+{
+    static const std::vector<std::vector<Key>> abc = {
+        {{"q","Q",K_TEXT,1},{"w","W",K_TEXT,1},{"e","E",K_TEXT,1},{"r","R",K_TEXT,1},{"t","T",K_TEXT,1},{"y","Y",K_TEXT,1},{"u","U",K_TEXT,1},{"i","I",K_TEXT,1},{"o","O",K_TEXT,1},{"p","P",K_TEXT,1},{"Del","Del",K_BKSP,1.4f}},
+        {{"a","A",K_TEXT,1},{"s","S",K_TEXT,1},{"d","D",K_TEXT,1},{"f","F",K_TEXT,1},{"g","G",K_TEXT,1},{"h","H",K_TEXT,1},{"j","J",K_TEXT,1},{"k","K",K_TEXT,1},{"l","L",K_TEXT,1},{"@","@",K_TEXT,1},{"Enter","Enter",K_ENTER,1.6f}},
+        {{"Shift","Shift",K_SHIFT,1.4f},{"z","Z",K_TEXT,1},{"x","X",K_TEXT,1},{"c","C",K_TEXT,1},{"v","V",K_TEXT,1},{"b","B",K_TEXT,1},{"n","N",K_TEXT,1},{"m","M",K_TEXT,1},{"_","_",K_TEXT,1},{".",".",K_TEXT,1},{"-","-",K_TEXT,1}},
+        {{"123","123",K_LAYER,1.6f},{"Space","Space",K_SPACE,5.4f},{"<","<",K_LEFT,1},{">",">",K_RIGHT,1},{"Hide","Hide",K_HIDE,1.4f}},
+    };
+    static const std::vector<std::vector<Key>> num = {
