+/* ------------------------------------------------------------------------ */
+/* Init / per frame                                                         */
+/* ------------------------------------------------------------------------ */
+/* PORT_DEBUG_KEYS=1: log which keyboard keys the game code reads */
+struct KeyCaller { uintptr_t ra; unsigned char keys[3][256]; int nkeys; };
+static KeyCaller key_callers[64];
+static int key_ncallers = 0;
+static uintptr_t yoyo_base = 0;
+static void key_log(int t, int k, uintptr_t ra)
+{
+    if (k < 0 || k > 255) return;
+    int i;
+    for (i = 0; i < key_ncallers; i++) if (key_callers[i].ra == ra) break;
+    if (i == key_ncallers) { if (key_ncallers >= 64) return; key_callers[i].ra = ra; key_ncallers++; }
+    KeyCaller &c = key_callers[i];
+    if (c.keys[t][k]) return;
+    c.keys[t][k] = 1;
+    if (++c.nkeys > 24) return;   /* key scanners (vk_anykey etc.) */
+    LOG("game reads key %d (%s) from +0x%lx\n", k, t == 0 ? "held" : (t == 1 ? "pressed" : "released"), (unsigned long)(ra - yoyo_base));
+}
+ABI_ATTR static int dbg_key_down(int k) { key_log(0, k, (uintptr_t)__builtin_return_address(0)); return (k >= 0 && k <= 255) ? _IO_KeyDown[k] != 0 : 0; }
+ABI_ATTR static int dbg_key_pressed(int k) { key_log(1, k, (uintptr_t)__builtin_return_address(0)); return (k >= 0 && k <= 255) ? _IO_KeyPressed[k] != 0 : 0; }
+ABI_ATTR static int dbg_key_released(int k) { key_log(2, k, (uintptr_t)__builtin_return_address(0)); return (k >= 0 && k <= 255) ? _IO_KeyReleased[k] != 0 : 0; }
+
+void port_init(JNIEnv *env, so_module *yoyo)
+{
+    if (getenv("PORT_DEBUG_KEYS")) {
+        yoyo_base = (uintptr_t)so_symbol(yoyo, "_Z11IO_Key_Downi") - 0x103a2f0;
+        hook_symbol(yoyo, "_Z11IO_Key_Downi", (uintptr_t)&dbg_key_down, 1);
+        hook_symbol(yoyo, "_Z14IO_Key_Pressedi", (uintptr_t)&dbg_key_pressed, 1);
+        hook_symbol(yoyo, "_Z15IO_Key_Releasedi", (uintptr_t)&dbg_key_released, 1);
+    }
+    g_env = env;
+    std::string here = cwd();
+    g_storage_root = env_or("PORT_STORAGE", here + "/storage");
+    g_files_dir = env_or("PORT_FILES", here + "/files");
+    g_import_dir = env_or("PORT_IMPORT", here + "/import");
+    mkdir_p(g_storage_root);
+    mkdir_p(g_files_dir);
+    mkdir_p(g_import_dir);
+
+    g_ca_file = env_or("PORT_CA_FILE", "");
+    if (g_ca_file.empty()) {
+        const char *cands[] = {"cacert.pem", "/etc/ssl/certs/ca-certificates.crt", "/etc/pki/tls/certs/ca-bundle.crt", "/etc/ssl/cert.pem"};
+        for (const char *c : cands) {
+            if (access(c, R_OK) == 0) {
+                g_ca_file = (c[0] == '/') ? std::string(c) : here + "/" + c;
+                break;
+            }
+        }
+    }
+
+#define NAT(var, name) var = (decltype(var))so_symbol(yoyo, "Java_com_yoyogames_runner_RunnerJNILib_" name); \
+    if (!var) LOG("native " name " not found\n");
+    NAT(n_HttpResult, "HttpResult");
+    NAT(n_HttpResultString, "HttpResultString");
+    NAT(n_InputResult, "InputResult");
+    NAT(n_LoginResult, "LoginResult");
+    NAT(n_VKStatus, "OnVirtualKeyboardStatus");
+    NAT(n_VKText, "OnVirtualKeyboardTextInserted");
+    NAT(n_KeyEvent, "KeyEvent");
+#undef NAT
+
+    g_option_scale = (int *)so_symbol(yoyo, "option_scale");
+    g_io_input_string = (char *)so_symbol(yoyo, "_IO_InputString");
+    g_io_last_char = (int *)so_symbol(yoyo, "_IO_LastChar");
+
+    g_yoyo = yoyo;
+    const char *ka = getenv("PORT_KEEP_ASPECT");
+    g_keep_aspect = (ka && atoi(ka)) ? 1 : 0;
+    LOG("storage=%s files=%s import=%s aspect=%s\n", g_storage_root.c_str(), g_files_dir.c_str(),
+        g_import_dir.c_str(), g_keep_aspect ? "keep" : "full");
+}
