+/* ------------------------------------------------------------------------ */
+/* Java extensions                                                          */
+/* ------------------------------------------------------------------------ */
+struct ExtArg {
+    bool is_str;
+    double d;
+    std::string s;
+};
+
+static jobject ret_d(double v) { return (jobject)JDouble::make(v); }
+static jobject ret_s(const std::string &s) { return (jobject)mkstr(s.c_str()); }
+
+static jobject ext_dispatch(const std::string &cls, const std::string &meth, const std::vector<ExtArg> &a)
+{
+    auto S = [&](size_t i) -> std::string { return i < a.size() ? (a[i].is_str ? a[i].s : std::to_string((long long)a[i].d)) : std::string(); };
+
+    /* PickMe: folders inside the "internal storage" */
+    if (meth == "getDire1" || meth == "getDire2" || meth == "getDire3" || meth == "getDire4") {
+        int n = meth[7] - '0';
+        std::string p = g_storage_root;
+        for (int i = 0; i < n; i++)
+            p += "/" + S(i);
+        mkdir_p(p);
+        return ret_s(p);
+    }
+    if (meth.compare(0, 3, "Chk") == 0)               /* permission checks */
+        return ret_d(1.0);
+    if (meth == "getExternalStorageDir" || meth == "GetExternalStorageDir")
+        return ret_s(g_files_dir);
+    if (meth == "IsKitKat")
+        return ret_d(1.0);
+    if (meth == "ShowFilePicker" || meth == "ShowFilePickerSwe") {
+        ui_open_dialog(PD_FILEPICK, 0, meth == "ShowFilePicker" ? "Import (.zip)" : "Import a file",
+                       g_import_dir.c_str(), "", meth == "ShowFilePicker" ? ".zip" : "");
+        return NULL;
+    }
+    if (meth == "share_file") {
+        LOG("share_file('%s') ignored on this device\n", S(0).c_str());
+        return NULL;
+    }
+    if (meth == "osNotice" || meth == "WriteExtStor" || meth == "MountFile" || meth == "ReadExtStor")
+        return NULL;
+
+    LOG("extension %s.%s(%zu args) not emulated\n", cls.c_str(), meth.c_str(), a.size());
+    return NULL;
+}
+
+jobject PortJNI::CallExtensionFunction5(JNIEnv *env, jclass clz, jstring cls, jstring meth, jint argc, jdoubleArray dargs, jobjectArray oargs)
+{
+    std::vector<ExtArg> a;
+    ArrayObject *d = (ArrayObject *)dargs, *o = (ArrayObject *)oargs;
+    for (int i = 0; i < argc; i++) {
+        ExtArg e = {false, 0.0, ""};
+        Object *obj = (o && i < o->count) ? ((Object **)o->elements)[i] : NULL;
+        if (obj) {
+            Class *c = obj->_getClass();
+            if (c == &String::clazz) { e.is_str = true; e.s = ((String *)obj)->str; }
+            else if (c == &JDouble::clazz) { e.d = ((JDouble *)obj)->value; }
+        } else if (d && i < d->count) {
+            e.d = ((double *)d->elements)[i];
+        }
+        a.push_back(e);
+    }
+    return ext_dispatch(jstr(cls), jstr(meth), a);
+}
+
+jobject PortJNI::CallExtensionFunction4(JNIEnv *env, jclass clz, jstring cls, jstring meth, jint argc, jobjectArray oargs)
+{
+    std::vector<ExtArg> a;
+    ArrayObject *o = (ArrayObject *)oargs;
+    for (int i = 0; i < argc; i++) {
+        ExtArg e = {false, 0.0, ""};
+        Object *obj = (o && i < o->count) ? ((Object **)o->elements)[i] : NULL;
+        if (obj) {
+            Class *c = obj->_getClass();
+            if (c == &String::clazz) { e.is_str = true; e.s = ((String *)obj)->str; }
+            else if (c == &JDouble::clazz) { e.d = ((JDouble *)obj)->value; }
+        }
+        a.push_back(e);
+    }
+    return ext_dispatch(jstr(cls), jstr(meth), a);
+}
