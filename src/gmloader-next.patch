+jstring PortJNI::GetUDID(JNIEnv *env, jclass clz)
+{
+    /* stable per installation, like ANDROID_ID */
+    static std::string id;
+    if (id.empty()) {
+        std::string f = g_files_dir + "/.device_id";
+        FILE *fp = fopen(f.c_str(), "r");
+        char buf[64] = {0};
+        if (fp) { if (fgets(buf, sizeof(buf), fp)) id = buf; fclose(fp); }
+        while (!id.empty() && (id.back() == '\n' || id.back() == '\r')) id.pop_back();
+        if (id.size() != 16) {
+            FILE *r = fopen("/dev/urandom", "rb");
+            unsigned char b[8] = {0};
+            if (r) { if (fread(b, 1, 8, r) != 8) {} fclose(r); }
+            char hex[17];
+            for (int i = 0; i < 8; i++) snprintf(hex + i * 2, 3, "%02x", b[i]);
+            id = hex;
+            fp = fopen(f.c_str(), "w");
+            if (fp) { fprintf(fp, "%s\n", id.c_str()); fclose(fp); }
+        }
+    }
+    return (jstring)mkstr(id.c_str());
+}
