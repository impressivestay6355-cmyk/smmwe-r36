+/* The game starts with its on-screen touch controls on (Android): in that mode
+   it ignores the gamepad. Turn them off, as the in-game "controls" setting
+   would (PORT_TOUCH_CONTROLS=1 keeps them). */
+static void touch_controls_off()
+{
+    static int slot = -2;
+    if (getenv("PORT_TOUCH_CONTROLS") && atoi(getenv("PORT_TOUCH_CONTROLS"))) return;
+    if (!Code_Variable_Find_Slot_From_Name || !Variable_GetValue_Direct || !Variable_SetValue_Direct || !g_pGlobal || !*g_pGlobal) return;
+    if (slot == -2) slot = Code_Variable_Find_Slot_From_Name(*g_pGlobal, "controles_tactiles");
+    if (slot < 0) return;
+    RValue v;
+    memset(&v, 0, sizeof(v));
+    Variable_GetValue_Direct(*g_pGlobal, slot, (int)0x80000000, &v, 0, 0);
+    int k = v.kind & 0xffffff;
+    bool on = (k == VALUE_REAL && v.rvalue.val != 0) || ((k == 7 || k == 13) && v.rvalue.v32 != 0);
+    static int last = -1;
+    if ((int)on != last) { LOG("touch controls: %s (kind %d)\n", on ? "on" : "off", k); last = on; }
+    if (!on) return;
+    RValue z;
+    memset(&z, 0, sizeof(z));
+    z.kind = VALUE_REAL;
+    z.rvalue.val = 0;
+    Variable_SetValue_Direct(*g_pGlobal, slot, (int)0x80000000, &z);
+    LOG("touch controls off (gamepad mode)\n");
+}
