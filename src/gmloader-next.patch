+                draw_text_field("Password", dlg_field[1], dlg_focus == 1, true, dw - 16);
+                if (ImGui::IsItemClicked()) { dlg_focus = 1; vk_caret = dlg_field[1].size(); }
+            }
+            ImGui::TextDisabled(vk_visible ? "START: OK   SELECT: cancel" : "A/START: OK   B/SELECT: cancel   keyboard button: show keyboard");
+        }
+        ImGui::End();
+        return;
+    }
+
+    float dh_max = top_h - 20;
+    ImGui::SetNextWindowSize(ImVec2(dw, 0));
+    ImGui::SetNextWindowPos(ImVec2(w * 0.5f, top_h * 0.5f), 0, ImVec2(0.5f, 0.5f));
+    ImGui::SetNextWindowSizeConstraints(ImVec2(dw, 0), ImVec2(dw, dh_max));
+    if (ImGui::Begin("##dlg", NULL, fl | ImGuiWindowFlags_AlwaysAutoResize)) {
+        if (dlg == PD_FILEPICK) {
+            ImGui::TextUnformatted(dlg_caption.c_str());
+            ImGui::Separator();
+            if (dlg_files.empty()) {
+                ImGui::PushTextWrapPos(dw - 16);
+                ImGui::Text("No files found. Copy the files to import into:\n%s\nthen press Y to refresh.", dlg_dir.c_str());
+                ImGui::PopTextWrapPos();
+            } else {
+                float lh = std::min(dh_max - g_font_px * 4, (g_font_px + 6) * 10);
+                ImGui::BeginChild("##files", ImVec2(dw - 16, lh), false);
+                for (int i = 0; i < (int)dlg_files.size(); i++) {
+                    if (ImGui::Selectable(dlg_files[i].c_str(), i == dlg_sel)) {
+                        dlg_sel = i;
+                        dialog_confirm(true);
+                        break;
+                    }
+                    if (i == dlg_sel) ImGui::SetScrollHereY(0.5f);
+                }
+                ImGui::EndChild();
+            }
+            ImGui::TextDisabled("A: import   B: cancel   Y: refresh");
+        } else {
+            ImGui::PushTextWrapPos(dw - 16);
+            ImGui::TextUnformatted(dlg_caption.c_str());
+            ImGui::PopTextWrapPos();
+            ImGui::Spacing();
+            float bw = (dw - 24) * 0.5f;
+            if (dlg == PD_QUESTION) {
+                ImGui::PushStyleColor(ImGuiCol_Button, dlg_choice == 0 ? ImVec4(0.10f, 0.62f, 0.88f, 1) : ImVec4(0.22f, 0.24f, 0.28f, 1));
+                if (ImGui::Button("Yes", ImVec2(bw, 0))) dialog_confirm(true);
+                ImGui::PopStyleColor();
+                ImGui::SameLine();
+                ImGui::PushStyleColor(ImGuiCol_Button, dlg_choice == 1 ? ImVec4(0.10f, 0.62f, 0.88f, 1) : ImVec4(0.22f, 0.24f, 0.28f, 1));
+                if (dlg != PD_NONE && ImGui::Button("No", ImVec2(bw, 0))) dialog_confirm(false);
+                ImGui::PopStyleColor();
+            } else {
+                ImGui::PushStyleColor(ImGuiCol_Button, ImVec4(0.10f, 0.62f, 0.88f, 1));
+                if (ImGui::Button("OK", ImVec2(dw - 16, 0))) dialog_confirm(true);
+                ImGui::PopStyleColor();
+            }
+        }
+    }
+    ImGui::End();
+}
+
+/* white cartoon glove pointing up-left; the tip of the index finger is the
+   hot spot. Built from capsules: black outline pass, then white fill. */
+struct Capsule { float ax, ay, bx, by, r; };
+static void capsule_poly(ImDrawList *dl, ImVec2 o, float s, float cs, float sn,
+                         const Capsule &c, float grow, ImU32 col)
+{
+    ImVec2 pts[26];
+    int n = 0;
+    float dx = c.bx - c.ax, dy = c.by - c.ay;
+    float base = atan2f(dy, dx);
+    float r = c.r * s + grow;
+    for (int end = 0; end < 2; end++) {
+        float cx = (end ? c.bx : c.ax) * s, cy = (end ? c.by : c.ay) * s;
+        float a0 = base + (end ? -1.5707963f : 1.5707963f);
+        for (int i = 0; i <= 12; i++) {
+            float a = a0 + 3.14159265f * i / 12.0f;
+            float x = cx + cosf(a) * r, y = cy + sinf(a) * r;
+            pts[n++] = ImVec2(o.x + x * cs - y * sn, o.y + x * sn + y * cs);
+        }
+    }
+    dl->AddConvexPolyFilled(pts, n, col);
+}
+
+static void draw_pointer(ImDrawList *dl)
+{
+    static const Capsule parts[] = {
+        { 0.00f, 0.11f, 0.00f, 0.56f, 0.11f },   /* index finger */
+        { 0.22f, 0.50f, 0.22f, 0.60f, 0.10f },   /* curled fingers */
+        { 0.40f, 0.52f, 0.40f, 0.62f, 0.10f },
+        { 0.56f, 0.56f, 0.56f, 0.66f, 0.09f },
+        { 0.12f, 0.74f, 0.44f, 0.74f, 0.22f },   /* palm */
+        {-0.13f, 0.62f, 0.05f, 0.82f, 0.09f },   /* thumb */
+        { 0.04f, 1.04f, 0.50f, 1.04f, 0.13f },   /* cuff */
+    };
+    const int n = sizeof(parts) / sizeof(parts[0]);
+    float s = g_font_px * 1.5f;
+    float ang = -0.35f;
+    float cs = cosf(ang), sn = sinf(ang);
+    ImVec2 o(floorf(ptr_x), floorf(ptr_y));
+    float line = s > 30 ? 2.5f : 2.0f;
+    ImU32 ink = IM_COL32(20, 20, 20, 255);
+    ImU32 fill = ptr_btn ? IM_COL32(255, 236, 140, 255) : IM_COL32(255, 255, 255, 255);
+    ImU32 shade = ptr_btn ? IM_COL32(222, 196, 90, 255) : IM_COL32(205, 210, 220, 255);
+    for (int i = 0; i < n; i++) capsule_poly(dl, o, s, cs, sn, parts[i], line, ink);
+    for (int i = 0; i < n; i++) capsule_poly(dl, o, s, cs, sn, parts[i], 0, fill);
+    /* cuff band and knuckle lines */
+    Capsule band = { 0.04f, 1.04f, 0.50f, 1.04f, 0.05f };
+    capsule_poly(dl, o, s, cs, sn, band, 0, shade);
+    auto P = [&](float x, float y) { x *= s; y *= s; return ImVec2(o.x + x * cs - y * sn, o.y + x * sn + y * cs); };
+    dl->AddLine(P(0.11f, 0.50f), P(0.11f, 0.64f), ink, line * 0.7f);
+    dl->AddLine(P(0.31f, 0.50f), P(0.31f, 0.64f), ink, line * 0.7f);
+    dl->AddLine(P(0.48f, 0.53f), P(0.48f, 0.66f), ink, line * 0.7f);
+}
+
+void ui_draw(int win_w, int win_h)
+{
+    ar_clear_bars(win_w, win_h);
+    Uint32 now = SDL_GetTicks();
+    bool hint = cfg_hint && now < hint_until;
+    bool need = vk_visible || dlg != PD_NONE || ptr_visible || hint || now < toast_until || cfg_show_fps;
+    if (!need) return;
+    if (!imgui_setup(win_w, win_h)) return;
+
+    /* save GL state ImGui's ES2 backend does not restore */
+    GLint fbo = 0, ebo = 0, vao = 0, attr_on[8];
+    glGetIntegerv(GL_FRAMEBUFFER_BINDING, &fbo);
+    glGetIntegerv(GL_ELEMENT_ARRAY_BUFFER_BINDING, &ebo);
+    if (glad_glBindVertexArrayOES) glGetIntegerv(GL_VERTEX_ARRAY_BINDING_OES, &vao);
+    for (int i = 0; i < 8; i++) glGetVertexAttribiv(i, GL_VERTEX_ATTRIB_ARRAY_ENABLED, &attr_on[i]);
+    if (vao && glad_glBindVertexArrayOES) glBindVertexArrayOES(0);
+    if (fbo) glBindFramebuffer(GL_FRAMEBUFFER, 0);
+
+    ImGuiIO &io = ImGui::GetIO();
+    io.DisplaySize = ImVec2((float)win_w, (float)win_h);
+    io.DeltaTime = 1.0f / 60.0f;
+    if (ptr_visible) {
+        io.AddMousePosEvent(ptr_x, ptr_y);
+        static bool last_btn = false;
+        if (ptr_btn != last_btn && (vk_visible || dlg != PD_NONE)) io.AddMouseButtonEvent(0, ptr_btn);
+        last_btn = ptr_btn;
+    }
+
+    ImGui_ImplOpenGL3_NewFrame();
+    ImGui::NewFrame();
+
+    if (dlg != PD_NONE) {
+        /* dim the game behind modal dialogs */
+        ImGui::GetBackgroundDrawList()->AddRectFilled(ImVec2(0, 0), ImVec2((float)win_w, (float)win_h), IM_COL32(0, 0, 0, 110));
+        draw_dialog((float)win_w, (float)win_h);
+    }
+    if (vk_visible) {
+        if (dlg == PD_NONE) {
+            /* show what is being typed */
+            float fw = std::min(win_w - 16.0f, std::max(win_w * 0.7f, 280.0f));
+            ImGui::SetNextWindowPos(ImVec2((win_w - fw) * 0.5f, win_h - vk_height_px - g_font_px * 2 - 28));
+            ImGui::SetNextWindowSize(ImVec2(fw, 0));
+            if (ImGui::Begin("##vkline", NULL, ImGuiWindowFlags_NoDecoration | ImGuiWindowFlags_NoMove | ImGuiWindowFlags_NoNav | ImGuiWindowFlags_AlwaysAutoResize))
+                draw_text_field(NULL, vk_text, true, false, fw - 16);
+            ImGui::End();
+        }
+        draw_keyboard((float)win_w, (float)win_h);
+    }
+    if (hint && dlg == PD_NONE && !vk_visible) {
+        float a = std::min(1.0f, (hint_until - now) / 800.0f);
+        ImGui::SetNextWindowPos(ImVec2(win_w * 0.5f, 8), 0, ImVec2(0.5f, 0));
+        ImGui::SetNextWindowBgAlpha(0.75f * a);
+        if (ImGui::Begin("##hint", NULL, ImGuiWindowFlags_NoDecoration | ImGuiWindowFlags_NoMove | ImGuiWindowFlags_NoNav | ImGuiWindowFlags_AlwaysAutoResize | ImGuiWindowFlags_NoInputs)) {
+            ImGui::PushStyleVar(ImGuiStyleVar_Alpha, a);
+            ImGui::Text("Pointer: %s stick, %s click, %s on/off    Quit: SELECT+START",
+                        cfg_ptr_stick == 0 ? "left" : "right",
+                        cfg_ptr_click == SDL_CONTROLLER_BUTTON_RIGHTSTICK ? "R3" : "button",
+                        cfg_ptr_toggle == 100 ? "L2" : cfg_ptr_toggle == 101 ? "R2" : (cfg_ptr_toggle == SDL_CONTROLLER_BUTTON_BACK ? "SELECT" : "button"));
+            ImGui::PopStyleVar();
+        }
+        ImGui::End();
+    }
+    if (now < toast_until && !toast.empty()) {
+        ImGui::SetNextWindowPos(ImVec2(win_w * 0.5f, win_h - 8.0f), 0, ImVec2(0.5f, 1.0f));
+        ImGui::SetNextWindowBgAlpha(0.8f);
+        if (ImGui::Begin("##toast", NULL, ImGuiWindowFlags_NoDecoration | ImGuiWindowFlags_NoMove | ImGuiWindowFlags_NoNav | ImGuiWindowFlags_AlwaysAutoResize | ImGuiWindowFlags_NoInputs))
+            ImGui::TextUnformatted(toast.c_str());
+        ImGui::End();
+    }
+    if (cfg_show_fps) {
+        char b[32];
+        snprintf(b, sizeof(b), "%.0f FPS", port_fps());
+        ImDrawList *dl = ImGui::GetForegroundDrawList();
+        dl->AddText(ImVec2(7, 5), IM_COL32(0, 0, 0, 255), b);
+        dl->AddText(ImVec2(6, 4), IM_COL32(255, 255, 80, 255), b);
+    }
+    if (ptr_visible)
+        draw_pointer(ImGui::GetForegroundDrawList());
+
+    ImGui::Render();
+    ImGui_ImplOpenGL3_RenderDrawData(ImGui::GetDrawData());
+
+    for (int i = 0; i < 8; i++) {
+        if (attr_on[i]) glEnableVertexAttribArray(i);
+        else glDisableVertexAttribArray(i);
+    }
+    glBindBuffer(GL_ELEMENT_ARRAY_BUFFER, ebo);
+    if (vao && glad_glBindVertexArrayOES) glBindVertexArrayOES(vao);
+    if (fbo) glBindFramebuffer(GL_FRAMEBUFFER, fbo);
+}
