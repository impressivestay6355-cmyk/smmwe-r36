+void PortJNI::HttpGet(JNIEnv *env, jclass clz, jstring url, jint id)
+{
+    HttpJob j;
+    j.id = id; j.url = jstr(url); j.method = "GET";
+    http_queue(std::move(j));
+}
+
+void PortJNI::HttpPost(JNIEnv *env, jclass clz, jstring url, jstring body, jint id)
+{
+    HttpJob j;
+    j.id = id; j.url = jstr(url); j.method = "POST";
+    const char *b = jstr(body);
+    j.body.assign(b, b + strlen(b));
+    j.headers = "Content-Type: application/x-www-form-urlencoded";
+    http_queue(std::move(j));
+}
+
+void PortJNI::HttpRequest(JNIEnv *env, jclass clz, jstring url, jstring method, jstring headers, jbyteArray body, jint id)
+{
+    HttpJob j;
+    j.id = id; j.url = jstr(url); j.method = jstr(method); j.headers = jstr(headers);
+    for (auto &ch : j.method) ch = toupper(ch);
+    if (j.method.empty()) j.method = "GET";
+    ArrayObject *b = (ArrayObject *)body;
+    if (b && b->count > 0 && b->elements) {
+        const char *p = (const char *)b->elements;
+        size_t n = (size_t)b->count;
+        /* the runner passes strings with their terminating zero */
+        if (n > 0 && p[n - 1] == 0) n--;
+        j.body.assign(p, p + n);
+    }
+    http_queue(std::move(j));
+}
