+void port_filepicker_result(const std::string &path)
+{
+    /* Same sequence as the APK's FilePicker: copy the file to
+       <files>/_temp, then report its display name. */
+    int m = CreateDsMap(0);
+    dsMapAddString(m, "type", "filepickerstart");
+    dsMapAddString(m, "result", "");
+    CreateAsynEventWithDSMap(m, 70);
+
+    std::string name;
+    if (!path.empty()) {
+        std::string dst = g_files_dir + "/_temp";
+        FILE *in = fopen(path.c_str(), "rb");
+        FILE *out = in ? fopen(dst.c_str(), "wb") : NULL;
+        if (in && out) {
+            char buf[65536];
+            size_t n;
+            while ((n = fread(buf, 1, sizeof(buf), in)) > 0)
+                fwrite(buf, 1, n, out);
+            size_t sl = path.find_last_of('/');
+            name = (sl == std::string::npos) ? path : path.substr(sl + 1);
+        }
+        if (in) fclose(in);
+        if (out) fclose(out);
+        LOG("file picker: '%s' -> '%s'\n", path.c_str(), name.c_str());
+    }
+
+    m = CreateDsMap(0);
+    dsMapAddString(m, "type", "filepicker");
+    dsMapAddString(m, "result", name.c_str());
+    CreateAsynEventWithDSMap(m, 70);
+}
