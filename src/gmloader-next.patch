+static bool file_exists(const std::string &p) { return access(p.c_str(), R_OK) == 0; }
+
+static bool imgui_setup(int win_w, int win_h)
+{
+    if (g_imgui_ready) return true;
+    if (g_imgui_failed) return false;
+
+    IMGUI_CHECKVERSION();
+    ImGui::CreateContext();
+    ImGuiIO &io = ImGui::GetIO();
+    io.IniFilename = NULL;
+    io.LogFilename = NULL;
+    io.BackendFlags = 0;
+    io.ConfigFlags |= ImGuiConfigFlags_NoMouseCursorChange;
+
+    float scale = std::min(win_w * 0.75f, (float)win_h) / 480.0f;
+    LOG("overlay for %dx%d\n", win_w, win_h);
+    if (scale < 0.75f) scale = 0.75f;
+    g_font_px = floorf(17.0f * scale);
+
+    static const ImWchar ranges[] = {
+        0x0020, 0x00FF, 0x0100, 0x017F, 0x0180, 0x024F, 0x0370, 0x03FF, 0x0400, 0x04FF,
+        0x1E00, 0x1EFF, 0x2000, 0x206F, 0x20A0, 0x20CF, 0x2190, 0x21FF, 0,
+    };
+    std::string font = getenv("PORT_FONT") ? getenv("PORT_FONT") : "fonts/NotoSans-Regular.ttf";
+    ImFontConfig cfg;
+    cfg.OversampleH = 1;
+    cfg.OversampleV = 1;
+    cfg.PixelSnapH = true;
+    if (file_exists(font) && io.Fonts->AddFontFromFileTTF(font.c_str(), g_font_px, &cfg, ranges)) {
+        LOG("font %s %.0fpx\n", font.c_str(), g_font_px);
+    } else {
+        ImFontConfig dc;
+        dc.SizePixels = 13.0f * std::max(1.0f, floorf(scale));
+        io.Fonts->AddFontDefault(&dc);
+        LOG("font: built-in\n");
+    }
+
+    ImGuiStyle &st = ImGui::GetStyle();
+    ImGui::StyleColorsDark(&st);
+    st.WindowRounding = 6.0f * scale;
+    st.FrameRounding = 4.0f * scale;
+    st.WindowBorderSize = 1.0f;
+    st.WindowPadding = ImVec2(8 * scale, 8 * scale);
+    st.ItemSpacing = ImVec2(4 * scale, 4 * scale);
+    st.Colors[ImGuiCol_WindowBg] = ImVec4(0.08f, 0.09f, 0.11f, 0.94f);
+    st.Colors[ImGuiCol_Button] = ImVec4(0.22f, 0.24f, 0.28f, 1.0f);
+    st.Colors[ImGuiCol_ButtonHovered] = ImVec4(0.30f, 0.33f, 0.38f, 1.0f);
+    st.Colors[ImGuiCol_ButtonActive] = ImVec4(0.10f, 0.52f, 0.78f, 1.0f);
+
+    if (!ImGui_ImplOpenGL3_Init(NULL)) {
+        LOG("ImGui GLES2 backend init failed\n");
+        g_imgui_failed = true;
+        return false;
+    }
+    g_imgui_ready = true;
+    return true;
+}
