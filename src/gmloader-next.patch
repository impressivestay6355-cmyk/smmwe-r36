+        {{"_","_",K_TEXT,1},{"\\","\\",K_TEXT,1},{"|","|",K_TEXT,1},{"~","~",K_TEXT,1},{"<","<",K_TEXT,1},{">",">",K_TEXT,1},{"\xe2\x82\xac","\xe2\x82\xac",K_TEXT,1},{"\xc2\xa3","\xc2\xa3",K_TEXT,1},{"\xc2\xa5","\xc2\xa5",K_TEXT,1},{"`","`",K_TEXT,1},{"Enter","Enter",K_ENTER,1.6f}},
