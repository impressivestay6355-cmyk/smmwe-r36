+/* Physical keyboard / mouse while the overlay is open */
+bool ui_handle_event(const SDL_Event *ev)
+{
+    bool text_dialog = (dlg == PD_INPUT || dlg == PD_LOGIN);
+    bool capture = text_dialog || vk_visible || dlg != PD_NONE;
+    if (!capture) return false;
+
+    if (g_imgui_ready) {
+        ImGuiIO &io = ImGui::GetIO();
+        if (ev->type == SDL_MOUSEMOTION) { io.AddMousePosEvent((float)ev->motion.x, (float)ev->motion.y); return true; }
+        if (ev->type == SDL_MOUSEBUTTONDOWN || ev->type == SDL_MOUSEBUTTONUP) {
+            if (ev->button.button == SDL_BUTTON_LEFT) {
+                io.AddMousePosEvent((float)ev->button.x, (float)ev->button.y);
+                io.AddMouseButtonEvent(0, ev->type == SDL_MOUSEBUTTONDOWN);
+            }
+            return true;
+        }
+    }
+    switch (ev->type) {
+    case SDL_TEXTINPUT:
+        if (text_dialog || vk_visible) vk_insert(ev->text.text);
+        return true;
+    case SDL_KEYDOWN:
+        switch (ev->key.keysym.sym) {
+        case SDLK_BACKSPACE: if (text_dialog || vk_visible) vk_backspace(); break;
+        case SDLK_LEFT: { std::string *t = edit_target(); vk_caret = utf8_prev(*t, std::min(vk_caret, t->size())); break; }
+        case SDLK_RIGHT: { std::string *t = edit_target(); vk_caret = utf8_next(*t, vk_caret); break; }
+        case SDLK_TAB: if (dlg == PD_LOGIN) { dlg_focus ^= 1; vk_caret = dlg_field[dlg_focus].size(); } break;
+        case SDLK_RETURN: case SDLK_KP_ENTER:
+            if (text_dialog || vk_visible) vk_enter(); else dialog_confirm(true);
+            break;
+        case SDLK_ESCAPE:
+            if (dlg != PD_NONE) dialog_confirm(false);
+            else { vk_manual = false; vk_from_game = false; set_vk_visible(false); }
+            break;
+        case SDLK_UP: if (dlg == PD_FILEPICK && !dlg_files.empty()) dlg_sel = std::max(0, dlg_sel - 1); break;
+        case SDLK_DOWN: if (dlg == PD_FILEPICK && !dlg_files.empty()) dlg_sel = std::min((int)dlg_files.size() - 1, dlg_sel + 1); break;
+        default: break;
+        }
+        return true;
+    case SDL_KEYUP:
+        return true;
+    default:
+        return false;
+    }
+}
