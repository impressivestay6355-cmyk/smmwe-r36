+        {{".",".",K_TEXT,1},{",",",",K_TEXT,1},{":",":",K_TEXT,1},{"!","!",K_TEXT,1},{"?","?",K_TEXT,1},{"/","/",K_TEXT,1},{"\\","\\",K_TEXT,1},{"\"","\"",K_TEXT,1},{"'","'",K_TEXT,1},{"@","@",K_TEXT,1},{"Enter","Enter",K_ENTER,1.6f}},
+        {{"#+=","#+=",K_SHIFT,1.4f},{"(","(",K_TEXT,1},{")",")",K_TEXT,1},{"-","-",K_TEXT,1},{"_","_",K_TEXT,1},{"+","+",K_TEXT,1},{"=","=",K_TEXT,1},{";",";",K_TEXT,1},{"$","$",K_TEXT,1},{"&","&",K_TEXT,1},{"*","*",K_TEXT,1}},
+        {{"abc","abc",K_LAYER,1.6f},{"Space","Space",K_SPACE,5.4f},{"<","<",K_LEFT,1},{">",">",K_RIGHT,1},{"Hide","Hide",K_HIDE,1.4f}},
