+/* PORT_DUMP_GLOBALS="a,b,c": print global variables at frame 300 (debug) */
+static void fmt_rvalue(RValue *v, char *out, size_t n)
+{
+    int k = v->kind & 0xffffff;
+    if (k == VALUE_REAL) snprintf(out, n, "%g", v->rvalue.val);
+    else if (k == 7) snprintf(out, n, "%d", v->rvalue.v32);
+    else if (k == 10) snprintf(out, n, "%lld", v->rvalue.v64);
+    else if (k == 13) snprintf(out, n, "%s", v->rvalue.val != 0 ? "true" : "false");
+    else if (k == 1 && v->rvalue.str && v->rvalue.str->m_thing) snprintf(out, n, "\"%.60s\"", (const char *)v->rvalue.str->m_thing);
+    else snprintf(out, n, "<kind %d>", k);
+}
+
+static void dump_globals()
+{
+    const char *env = getenv("PORT_DUMP_GLOBALS");
+    if (!env || !Code_Variable_Find_Slot_From_Name || !Variable_GetValue_Direct || !g_pGlobal) return;
+    std::string l = env;
+    size_t p = 0;
+    while (p < l.size()) {
+        size_t e = l.find(',', p);
+        if (e == std::string::npos) e = l.size();
+        std::string name = l.substr(p, e - p);
+        p = e + 1;
+        int slot = Code_Variable_Find_Slot_From_Name(*g_pGlobal, name.c_str());
+        if (slot < 0) { LOG("global %s: no slot\n", name.c_str()); continue; }
+        RValue v;
+        memset(&v, 0, sizeof(v));
+        Variable_GetValue_Direct(*g_pGlobal, slot, (int)0x80000000, &v, 0, 0);
+        char buf[128];
+        fmt_rvalue(&v, buf, sizeof(buf));
+        std::string line = std::string("global ") + name + " = " + buf;
+        if ((v.kind & 0xffffff) == 2) {
+            line += " [";
+            for (int i = 0; i < 24; i++) {
+                RValue el;
+                memset(&el, 0, sizeof(el));
+                if (!Variable_GetValue_Direct(*g_pGlobal, slot, i, &el, 0, 0)) break;
+                fmt_rvalue(&el, buf, sizeof(buf));
+                line += std::string(i ? ", " : "") + buf;
+            }
+            line += "]";
+        }
+        LOG("%s\n", line.c_str());
+    }
+}
