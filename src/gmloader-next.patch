+/*
+ * On-screen overlay for handhelds (Dear ImGui, GLES2):
+ *  - virtual keyboard driven by the gamepad (opens/closes automatically when
+ *    the game asks for text, or manually with the keyboard button);
+ *  - text input / login / message / question dialogs used by the game's
+ *    get_string_async, get_login_async, show_message_async, ...;
+ *  - file picker for the game's "import level" extension;
+ *  - a pointer moved with a stick, for the touch menus.
+ *
+ * Gamepad layout while the keyboard is open (defaults):
+ *   D-pad / left stick  move        A  type key (hold: accents)
+ *   B  backspace        X  space     Y  shift
+ *   L1 / R1  letters/numbers/symbols
+ *   START  confirm (Enter)   SELECT  cancel   keyboard button  hide/show
+ */
+#include <SDL2/SDL.h>
+#include <stdio.h>
